{
  "name": "inflector-keeno",
  "displayName": "Keeno Framework",
  "description": "Syntax highlighting and IntelliSense for Keeno (.kn) components",
  "version": "0.2.0",
  "publisher": "inflector",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliesw/Keeno.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://keeno.inflector.io",
  "bugs": {
    "url": "https://github.com/iliesw/Keeno/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "main": "./dist/client.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "keeno",
        "aliases": [
          "Keeno",
          "keeno"
        ],
        "extensions": [
          ".kn"
        ],
        "icon": {
          "light": "./images/file-icon-light.svg",
          "dark": "./images/file-icon-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "css": {
      "customData": [
        "./dist/tailwind.css-data.json"
      ]
    },
    "configurationDefaults": {
      "tailwindCSS.includeLanguages": {
        "keeno": "html"
      }
    },
    "grammars": [
      {
        "language": "keeno",
        "scopeName": "source.keeno",
        "path": "./syntaxes/keeno.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.keeno.script": "typescriptreact",
          "meta.embedded.block.keeno.style": "css",
          "meta.embedded.expression.keeno": "typescriptreact"
        }
      }
    ]
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "package": "bun run scripts/package.ts"
  },
  "devDependencies": {
    "@inflector/keeno-language-server": "workspace:*",
    "@types/vscode": "~1.90.0",
    "@volar/vscode": "~2.4.28",
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
