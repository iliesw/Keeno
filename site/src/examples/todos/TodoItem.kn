<script lang="ts">
  type Props = {
    todo: { id: number; text: string; done: boolean }
    onToggle: (id: number) => void
    onRemove: (id: number) => void
  }
  // Destructured props stay reactive.
  const { todo, onToggle, onRemove } = props<Props>()
</script>

<li class={{ done: todo.done }}>
  <label>
    <input type="checkbox" checked={todo.done} onChange={() => onToggle(todo.id)} />
    <span>{todo.text}</span>
  </label>
  <button aria-label={`Remove ${todo.text}`} onClick={() => onRemove(todo.id)}>✕</button>
</li>

<style>
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  li:last-child {
    border-bottom: none;
  }
  li:hover {
    background: var(--hover);
  }
  label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .done span {
    text-decoration: line-through;
    color: var(--muted);
  }
  button {
    min-height: 1.5rem;
    padding: 0 0.4rem;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--muted);
    opacity: 0;
  }
  button:hover:not(:disabled) {
    background: var(--surface);
    color: var(--danger);
  }
  li:hover button,
  button:focus-visible {
    opacity: 1;
  }
</style>
