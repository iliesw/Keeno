<script lang="ts">
  import { ErrorBoundary } from '@inflector/keeno'
  import Fragile from './Fragile.kn'

  const caught = state(0)
</script>

<div class="demo">
  <ErrorBoundary
    fallback={(error, reset) => (
      <div class="fallback" role="alert">
        <span class="icon">!</span>
        <div class="body">
          <strong>Something broke</strong>
          <code>{String(error)}</code>
        </div>
        <button onClick={reset}>Try again</button>
      </div>
    )}
    onError={(error) => {
      caught.set(caught.peek() + 1)
      console.warn('Caught by the boundary:', error)
    }}
  >
    <Fragile />
  </ErrorBoundary>

  <p class="meta">
    <span>The child throws at 3; the boundary shows a fallback.</span>
    <span class="count">caught {caught}</span>
  </p>
</div>

