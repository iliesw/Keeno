{
  "name": "@inflector/keeno-compiler",
  "version": "0.6.1",
  "description": "Compiler for Keeno (.kn) single-file components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliesw/Keeno.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/iliesw/Keeno/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/iliesw/Keeno/issues"
  },
  "keywords": [
    "keeno",
    "compiler",
    "kn",
    "components"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "keeno-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./split": {
      "keeno-source": "./src/split.ts",
      "types": "./dist/split.d.ts",
      "import": "./dist/split.js",
      "default": "./dist/split.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts --target=node",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@babel/generator": "^7.26.2",
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.25.9",
    "@babel/types": "^7.26.0",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^7.0.0"
  },
  "devDependencies": {
    "@inflector/keeno": "workspace:*",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6"
  },
  "engines": {
    "node": ">=18"
  }
}
