<script lang="ts">
  // One source of truth, in °C. validate() rounds every write and rejects non-numbers.
  const celsius = state(21, {
    validate: (next, prev) => (Number.isFinite(next) ? Math.round(next * 10) / 10 : prev),
  })
  const fahrenheit = derived(() => Math.round((celsius * 9) / 5 + 32))
  const feel = derived(() =>
    celsius < 0 ? 'Freezing' : celsius < 15 ? 'Chilly' : celsius < 25 ? 'Pleasant' : celsius < 35 ? 'Warm' : 'Hot',
  )
  const tone = derived(() =>
    celsius < 15 ? 'var(--info)' : celsius < 25 ? 'var(--success)' : celsius < 35 ? 'var(--warning)' : 'var(--danger)',
  )

  const fromC = (e: Event) => celsius.set(Number((e.target as HTMLInputElement).value))
  const fromF = (e: Event) => celsius.set(((Number((e.target as HTMLInputElement).value) - 32) * 5) / 9)
</script>

<div class="temp" style={`--tone: ${tone}`}>
  <div class="fields">
    <label>
      <span class="label">Celsius</span>
      <span class="field">
        <input type="number" step="0.5" value={celsius} onInput={fromC} />
        <span class="unit">°C</span>
      </span>
    </label>
    <span class="eq" aria-hidden="true">⇄</span>
    <label>
      <span class="label">Fahrenheit</span>
      <span class="field">
        <input type="number" value={fahrenheit} onChange={fromF} />
        <span class="unit">°F</span>
      </span>
    </label>
  </div>

  <div class="scale">
    <input type="range" min="-20" max="45" step="0.5" value={celsius} onInput={fromC} aria-label="Temperature in Celsius" />
    <div class="ticks" aria-hidden="true">
      {[-20, 0, 15, 25, 45].map((t) => (
        <span key={t} style={`left: ${((t + 20) / 65) * 100}%`}>{t < 0 ? `−${-t}` : t}°</span>
      ))}
    </div>
  </div>

  <p class="feel"><span class="dot"></span>{feel}</p>
</div>

<style>
  .temp {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 380px);
    margin: 0 auto;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.5rem;
  }
  label {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }
  .field {
    position: relative;
    display: block;
  }
  .field input {
    width: 100%;
    min-height: 3rem;
    padding-right: 2.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    -moz-appearance: textfield;
  }
  .field input::-webkit-inner-spin-button,
  .field input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .unit {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%);
    font-size: 0.85rem;
    color: var(--faint);
    pointer-events: none;
  }
  .eq {
    display: grid;
    place-items: center;
    height: 3rem;
    color: var(--faint);
  }
  .scale {
    display: grid;
    gap: 0.5rem;
  }
  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    margin: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #52a8ff, #3cb35b 45%, #ffb224 70%, #ff6166);
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 1px var(--border-strong), 0 2px 6px rgb(0 0 0 / 0.25);
    transition: transform 0.15s;
  }
  input[type='range']::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 1px var(--border-strong), 0 2px 6px rgb(0 0 0 / 0.25);
  }
  input[type='range']:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  .ticks {
    position: relative;
    height: 1rem;
    margin: 0 9px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--faint);
  }
  .ticks span {
    position: absolute;
    transform: translateX(-50%);
  }
  .feel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    margin: 0 auto;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone);
    transition: background 0.2s;
  }
</style>
