{
  "name": "@inflector/keeno-router",
  "version": "0.3.0",
  "description": "Client-side router for Keeno (.kn) apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliesw/Keeno.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/iliesw/Keeno/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/iliesw/Keeno/issues"
  },
  "keywords": [
    "keeno",
    "router",
    "routing",
    "spa"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "keeno-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts --target=browser",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@inflector/keeno": ">=0.5.0 <1.0.0"
  },
  "devDependencies": {
    "@inflector/keeno": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
