<p>Hello, <strong>{name}</strong>.</p>
<button onClick={() => open.set(true)}>Edit profile</button>

<Modal open={open} title="Edit profile" onClose={() => open.set(false)}>
  <label>
    Display name
    <input bind:value={name} />
  </label>
  <p class="hint">Changes apply as you type. Press Esc or click outside to close.</p>
</Modal>

