{
  "name": "keeno-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e/app",
    "site"
  ],
  "scripts": {
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "test:e2e:install": "bunx playwright install chromium firefox webkit",
    "test:smoke": "bun run scripts/smoke.ts",
    "bench": "bun run scripts/bench.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun run scripts/build.ts",
    "devtools": "bun run scripts/build-devtools.ts",
    "predev": "bun run build",
    "dev": "bun run scripts/dev.ts",
    "docs:llms": "bun run scripts/build-llms.ts",
    "changeset": "changeset",
    "version-packages": "bun run scripts/version.ts",
    "release": "bun run scripts/release.ts",
    "docs:dev": "bun run --cwd site dev",
    "docs:build": "bun run build && bun run --cwd site build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3"
  }
}
