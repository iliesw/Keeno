<script lang="ts">
  import { reparentable } from '@inflector/lux'
  import Widget from './Widget.lx'

  const native = 'moveBefore' in Element.prototype
  const theater = state(false)
  // Rendered once; `{player}` in markup or `player.moveTo()` decides where it is.
  const player = reparentable(() => <Widget label="Live widget" />)

  function drop(e: DragEvent) {
    e.preventDefault()
    player.moveTo(e.currentTarget as Element)
  }
</script>

<section class="mt-8 max-w-3xl">
  <h2 class="text-xl font-bold">Reparenting</h2>
  <p class="mt-1 text-sm opacity-70">
    The widget keeps its stopwatch, input and iframe wherever it goes.{' '}
    {native ? 'Moves are native (moveBefore): focus and the iframe survive too.' : 'This browser has no moveBefore: component state survives, the iframe reloads.'}
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    <button class="btn" onClick={() => theater.set(!theater)}>{theater ? 'Exit theater' : 'Theater mode'}</button>
    <button class="btn btn-ghost" onClick={() => player.moveTo('#dock-a')}>Move to dock A</button>
    <button class="btn btn-ghost" onClick={() => player.moveTo('#dock-b')}>Move to dock B</button>
    <button class="btn btn-ghost" onClick={() => player.remove()}>Hide</button>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    <div class="slot">
      <span class="slot-label">Inline (markup)</span>
      {!theater && player}
    </div>
    <div id="dock-a" class="slot" onDragover={(e) => e.preventDefault()} onDrop={drop}>
      <span class="slot-label">Dock A (drop here)</span>
    </div>
    <div id="dock-b" class="slot" onDragover={(e) => e.preventDefault()} onDrop={drop}>
      <span class="slot-label">Dock B (drop here)</span>
    </div>
  </div>
  <p class="mt-2 text-xs opacity-60">Drag the widget by its top bar onto a dock. Theater mode renders it anew in markup, which takes it back from a dock.</p>

  {theater && (
    <div class="fixed inset-0 z-10 grid place-items-center bg-black/60 p-8" onClick={() => theater.set(false)}>
      <div class="w-full max-w-md" onClick={(e) => e.stopPropagation()}>{player}</div>
    </div>
  )}
</section>

<style>
  /* Scoped styles: App.lx's .btn doesn't reach here, so this component has its own. */
  .btn {
    @apply rounded-lg bg-brand px-4 py-2 font-medium text-white hover:brightness-110;
  }
  .btn-ghost {
    @apply bg-transparent text-brand ring-1 ring-brand;
  }
  .slot {
    @apply flex min-h-48 flex-col gap-2 rounded-xl border-2 border-dashed border-slate-300 p-3;
  }
  .slot-label {
    @apply text-xs font-semibold tracking-wide text-slate-500 uppercase;
  }
</style>
