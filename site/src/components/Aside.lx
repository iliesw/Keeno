<script lang="ts">
  import Icon from './Icon.lx'
  import type { Heading } from '../docs'

  const { headings } = props<{ headings: Heading[] }>()

  const active = state('')
  const thumb = state({ top: 0, height: 0, left: 0, visible: false })

  const lineOffset = (depth: number) => (depth >= 3 ? 12 : 0)
  const itemOffset = (depth: number) => (depth >= 3 ? 28 : 16)
  const prevChanges = (i: number) => i > 0 && lineOffset(headings[i - 1].depth) !== lineOffset(headings[i].depth)
  const nextChanges = (i: number) => i < headings.length - 1 && lineOffset(headings[i + 1].depth) !== lineOffset(headings[i].depth)

  // Follow the reading position: the active heading is the last one above the top of the page.
  const onScroll = () => {
    let id = headings[0]?.id ?? ''
    for (const h of headings) {
      const el = document.getElementById(h.id)
      if (el && el.getBoundingClientRect().top <= 130) id = h.id
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4
    if (atBottom && headings.length) id = headings[headings.length - 1].id
    active.set(id)
  }
  init(() => {
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  })
  const measure = () => {
    const frame = requestAnimationFrame(onScroll)
    return () => cancelAnimationFrame(frame)
  }
  init(measure)
  update(measure, [headings])

  // Slide the thumb to the active link.
  update(() => {
    const id = active
    const h = headings.find((x) => x.id === id)
    const link = h ? document.querySelector<HTMLElement>(`#toc a[data-id="${CSS.escape(id)}"]`) : null
    if (!h || !link) {
      thumb.set({ ...thumb.peek(), visible: false })
      return
    }
    thumb.set({ top: link.offsetTop, height: link.offsetHeight, left: lineOffset(h.depth), visible: true })
  })
</script>

{headings.length > 0 && (
  <nav id="toc" class="flex w-64 min-w-64 flex-col gap-3 pr-4 pb-2" aria-label="On this page">
    <p class="flex h-6 items-center gap-2 text-sm"><Icon name="listMinus" /> On This Page</p>
    <div class="relative flex flex-col">
      <span
        class="pointer-events-none absolute z-10 w-0.5 -translate-x-[0.5px] rounded-full bg-brand transition-all duration-150 dark:bg-white"
        style={`top:${thumb.top}px;height:${thumb.height}px;left:${thumb.left}px;opacity:${thumb.visible ? 1 : 0}`}
      ></span>
      {headings.map((h, i) => (
        <a
          key={h.id}
          href={`#${h.id}`}
          data-id={h.id}
          style={`padding-left:${itemOffset(h.depth)}px`}
          class={[
            'relative block py-1.5 text-sm transition-colors',
            active === h.id
              ? 'font-medium text-neutral-900 dark:text-white'
              : 'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100',
          ]}
        >
          {prevChanges(i) && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="absolute -top-1.5 left-0 h-4 w-4">
              <line x1={lineOffset(headings[i - 1].depth)} y1="0" x2={lineOffset(h.depth)} y2="12" class="stroke-neutral-200 dark:stroke-neutral-800" stroke-width="1" />
            </svg>
          )}
          <span
            class={['absolute inset-y-0 w-px bg-neutral-200 dark:bg-neutral-800', prevChanges(i) && 'top-1.5', nextChanges(i) && 'bottom-1.5']}
            style={`left:${lineOffset(h.depth)}px`}
          ></span>
          <span class="block truncate">{h.text}</span>
        </a>
      ))}
    </div>
  </nav>
)}
