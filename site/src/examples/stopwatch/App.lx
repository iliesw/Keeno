<script lang="ts">
  const elapsed = state(0)
  const running = state(false)
  const laps = state<number[]>([])

  let started = 0
  let frame = 0

  function tick() {
    elapsed.set(performance.now() - started)
    frame = requestAnimationFrame(tick)
  }
  function toggle() {
    if (running) {
      cancelAnimationFrame(frame)
    } else {
      started = performance.now() - elapsed
      frame = requestAnimationFrame(tick)
    }
    running.set(!running)
  }
  function reset() {
    cancelAnimationFrame(frame)
    running.set(false)
    elapsed.set(0)
    laps.set([])
  }
  const lap = () => laps.set([elapsed.peek(), ...laps])

  // Cleanup when the component goes away: no frame keeps running.
  destroy(() => cancelAnimationFrame(frame))

  const format = (ms: number) => {
    const m = Math.floor(ms / 60000)
    const s = Math.floor((ms % 60000) / 1000)
    const cs = Math.floor((ms % 1000) / 10)
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${String(cs).padStart(2, '0')}`
  }
  const fastest = derived(() => {
    const splits = laps.map((t, i) => t - (laps[i + 1] ?? 0))
    return splits.length > 1 ? splits.indexOf(Math.min(...splits)) : -1
  })
</script>

<div class="watch">
  <p class="time">{format(elapsed)}</p>
  <div class="row">
    <button class="secondary" onClick={running ? lap : reset} disabled={!running && elapsed === 0}>{running ? 'Lap' : 'Reset'}</button>
    <button class={['primary', running && 'stop']} onClick={toggle}>{running ? 'Stop' : 'Start'}</button>
  </div>
  <ol>
    {laps.map((t, i) => (
      <li key={t} class={{ best: i === fastest }}>
        <span>Lap {laps.length - i}</span>
        <span>{format(t - (laps[i + 1] ?? 0))}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .watch {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 320px;
    margin: 0 auto;
  }
  .time {
    margin: 0;
    font: 600 3.2rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .row {
    display: flex;
    gap: 1rem;
  }
  .row button {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    font-weight: 600;
  }
  .primary {
    background: #16a34a;
    border-color: #16a34a;
    color: white;
  }
  .primary:hover:not(:disabled) {
    background: #15803d;
  }
  .primary.stop {
    background: #dc2626;
    border-color: #dc2626;
  }
  ol {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 180px;
    overflow: auto;
  }
  li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.25rem;
    border-bottom: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
  }
  li.best {
    color: #16a34a;
  }
</style>
