<script lang="ts">
  import Rating from './Rating.kn'

  const reviews = state([
    { id: 1, label: 'Docs', value: 4 },
    { id: 2, label: 'Performance', value: 5 },
    { id: 3, label: 'Tooling', value: 3 },
  ])
  const average = derived(() => reviews.reduce((s, r) => s + r.value, 0) / reviews.length)

  const rate = (id: number, value: number) => reviews.set(reviews.map((r) => (r.id === id ? { ...r, value } : r)))
</script>

<div class="summary">
  <strong>{average.toFixed(1)}</strong>
  <!-- The same component, read-only and with half stars. -->
  <Rating value={average} readonly size={22} />
</div>

<ul>
  {reviews.map((r) => (
    <li key={r.id}>
      <span>{r.label}</span>
      <Rating value={r.value} onChange={(v: number) => rate(r.id, v)} />
    </li>
  ))}
</ul>

