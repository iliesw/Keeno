{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    // Workspace packages resolve to their sources, so tests, typechecking and the language server
    // never need a build. Bun applies these at runtime too. Published consumers get dist/ through
    // each package's `exports`; packages/*/tsconfig.build.json turns this off for declaration builds.
    "paths": {
      "@inflector/keeno": ["./packages/keeno/src/index.ts"],
      "@inflector/keeno/internal": ["./packages/keeno/src/internal.ts"],
      "@inflector/keeno/kn": ["./packages/keeno/src/kn.d.ts"],
      "@inflector/keeno/devtools": ["./packages/keeno/src/devtools-ui.ts"],
      "@inflector/keeno-compiler": ["./packages/compiler/src/index.ts"],
      "@inflector/keeno-compiler/split": ["./packages/compiler/src/split.ts"],
      "@inflector/vite-plugin-keeno": ["./packages/vite-plugin-keeno/src/index.ts"],
      "@inflector/keeno-language-server": ["./packages/language-server/src/index.ts"],
      "@inflector/keeno-language-server/server": ["./packages/language-server/src/server.ts"],
      "@inflector/keeno-check": ["./packages/keeno-check/src/check.ts"],
      "@inflector/keeno/server": ["./packages/keeno/src/server.ts"],
      "@inflector/keeno-router": ["./packages/router/src/index.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}
