<script lang="ts">
  const emails = state(true)
  const digest = state('weekly')
</script>

<label><input type="checkbox" bind:checked={emails} /> Email notifications</label>
<label class={{ off: !emails }}>
  Digest
  <select bind:value={digest} disabled={!emails}>
    <option value="daily">Daily</option>
    <option value="weekly">Weekly</option>
    <option value="monthly">Monthly</option>
  </select>
</label>
<p>{emails ? `You get a ${digest} digest.` : 'No emails.'} (Resets when you switch tabs.)</p>

<style>
  label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .off {
    opacity: 0.5;
