<script lang="ts">
  import { Link } from '@inflector/lux-router'
  import { runtimeKb } from 'virtual:lux-stats'
  import Footer from '../components/Footer.lx'
  import Icon from '../components/Icon.lx'
  import LiveDemo from '../components/LiveDemo.lx'
  import Navbar from '../components/Navbar.lx'
  import BindingDemo from '../components/demos/BindingDemo.lx'
  import CounterDemo from '../components/demos/CounterDemo.lx'
  import TodoDemo from '../components/demos/TodoDemo.lx'
  import { onContentClick } from '../content'
  import { exampleComponent, examples, findExample } from '../examples'
  import { GITHUB, spark, type IconName } from '../icons'
  import binding from '../snippets/binding.md'
  import compiled from '../snippets/Counter.lx?compiled'
  import source from '../snippets/Counter.lx?highlight'
  import counter from '../snippets/counter.md'
  import todo from '../snippets/todo.md'
  import { VERSION } from '../version'

  init(() => {
    document.title = 'Lux · The compiled, signal-based UI framework'
  })

  const INSTALL = 'bun add @inflector/lux'
  const copied = state(false)
  function copyInstall() {
    navigator.clipboard?.writeText(INSTALL)
    copied.set(true)
    setTimeout(() => copied.set(false), 1200)
  }

  const tabs = [
    { id: 'counter', name: 'Counter', html: counter.html, blurb: 'state() and derived(): read a state like a value, write it with .set().', example: 'counter' },
    { id: 'todo', name: 'Todo', html: todo.html, blurb: 'Keyed lists compile to fine-grained reconciliation: only the rows that change are touched.', example: 'todos' },
    { id: 'binding', name: 'Binding', html: binding.html, blurb: 'bind:value and bind:checked give two-way binding straight to a state.', example: 'form' },
  ]
  const tab = state('counter')
  const current = derived(() => tabs.find((t) => t.id === tab)!)

  const stats = [
    { value: `${runtimeKb} KB`, label: 'whole runtime, min + gzip' },
    { value: '0', label: 'virtual DOM nodes' },
    { value: '1×', label: 'each component runs once' },
    { value: `${examples.length}`, label: 'live examples' },
  ]

  const tools = ['vite', 'bun', 'typescript', 'tailwindcss', 'vscode', 'nodejs', 'deno', 'vitest', 'playwright']

  const features: { icon: IconName; title: string; text: string; points: string[]; wide?: boolean; href: string }[] = [
    {
      icon: 'zap',
      title: 'Fine-grained signals',
      text: 'state() creates a signal, derived() computes from others. Templates subscribe to exactly what they read, so a change updates one text node, not a component tree.',
      points: ['No virtual DOM', 'Batched DOM updates', 'persist, url, history, debounce options'],
      wide: true,
      href: '/docs/reactivity',
    },
    { icon: 'palette', title: 'Scoped CSS', text: 'Every <style> is scoped to its component, with :global() as the escape hatch and first-class Tailwind CSS v4.', points: [], href: '/docs/styles' },
    { icon: 'cpu', title: 'Compiled', text: 'The compiler turns HTML-first .lx files into direct DOM code. Components run once and never re-render.', points: [], href: '/docs/components' },
    { icon: 'move', title: 'Reparenting', text: 'Move live content between places, iframes and videos included, without re-creating it, using native moveBefore.', points: [], href: '/docs/built-ins#reparentable' },
    { icon: 'server', title: 'SSR & hydration', text: 'renderToString on Node, Bun or Deno, hydrate in the browser. This site is rendered that way.', points: [], href: '/docs/ssr' },
    {
      icon: 'wrench',
      title: 'Tooling',
      text: 'A Vite plugin with HMR, a VS Code extension with full TypeScript IntelliSense in .lx files, and lux-check for CI.',
      points: ['Vite plugin + HMR', 'VS Code extension', 'lux-check type checker'],
      wide: true,
      href: '/docs/tooling',
    },
    { icon: 'route', title: 'Router', text: 'A tiny History API router with params, lazy routes, active links and server rendering.', points: [], href: '/docs/routing' },
  ]

  const showcase = ['pixel-art', 'kanban', 'clock'].map((slug) => findExample(slug)!)
</script>

<Navbar />
<div class="relative w-full overflow-x-hidden" onClick={onContentClick}>
  <!-- Hero -->
  <section class="relative">
    <div class="hero-grid pointer-events-none absolute inset-0 -z-10"></div>
    <div class="hero-glow pointer-events-none absolute inset-0 -z-10"></div>
    <div class="animate-fade-up mx-auto flex max-w-400 flex-col items-center px-6 pt-36 text-center md:pt-44">
      <Link href="/playground" class="group flex items-center gap-2 rounded-full border bg-white/70 py-1 pr-3 pl-1 text-sm backdrop-blur transition hover:border-orange-400 dark:bg-neutral-900/70">
        <span class="rounded-full bg-orange-400 px-2 py-0.5 font-code text-[11px] font-bold text-black">v{VERSION}</span>
        <span>Try Lux in the new playground</span>
        <span class="transition-transform group-hover:translate-x-0.5"><Icon name="arrowRight" /></span>
      </Link>
      <h1 class="mt-7 font-s2 text-5xl leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
        Build UIs that <span class="font-s3 text-gradient">shine.</span>
      </h1>
      <p class="mt-6 max-w-2xl font-s2 text-lg text-neutral-600 md:text-xl dark:text-neutral-400">
        Lux is a compiled, signal-based frontend framework. Write HTML-first <code class="font-code text-neutral-900 dark:text-white">.lx</code> components, get fine-grained DOM updates. No virtual DOM, no re-renders.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <Link href="/docs/getting-started" class="flex items-center gap-2 rounded-xl bg-neutral-900 px-5 py-2.5 font-s2 font-bold text-white shadow-lg shadow-black/10 transition hover:-translate-y-px hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-neutral-200">
          Get started <Icon name="arrowRight" />
        </Link>
        <Link href="/playground" class="flex items-center gap-2 rounded-xl border bg-white px-5 py-2.5 font-s2 font-bold transition hover:-translate-y-px hover:border-orange-400 dark:bg-neutral-900">
          <span class="text-orange-500"><Icon name="play" /></span> Playground
        </Link>
      </div>
      <button type="button" onClick={copyInstall} class="group mt-5 flex cursor-pointer items-center gap-3 rounded-xl border border-dashed px-4 py-2 font-code text-sm text-neutral-600 transition hover:border-solid hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white" title="Copy">
        <span class="text-orange-500">$</span> {INSTALL}
        <span class="opacity-50 group-hover:opacity-100"><Icon name={copied ? 'check' : 'copy'} /></span>
      </button>
    </div>

    <!-- Live editor-like showcase -->
    <div class="mx-auto mt-20 w-full max-w-6xl px-4 md:mt-24 md:px-6">
      <div class="flex flex-col justify-between gap-3 pb-4 md:flex-row md:items-end">
        <div>
          <p class="font-s2 text-xl">Components that read like HTML</p>
          <p class="font-s2 text-sm text-neutral-500">{current.blurb}</p>
        </div>
        <div class="flex w-fit gap-0.5 rounded-xl bg-neutral-200/70 p-1 font-s2 text-sm font-black dark:bg-neutral-900" role="tablist">
          {tabs.map((t) => (
            <button
              key={t.id}
              type="button"
              role="tab"
              aria-selected={tab === t.id}
              onClick={() => tab.set(t.id)}
              class={['cursor-pointer rounded-lg px-4 py-1.5 transition', tab === t.id ? 'bg-white shadow-sm dark:bg-neutral-800' : 'opacity-60 hover:opacity-100']}
            >
              {t.name}
            </button>
          ))}
        </div>
      </div>
      <div class="relative grid grid-cols-1 overflow-hidden rounded-3xl border bg-gradient-to-br from-orange-300 via-orange-400 to-amber-500 p-3 shadow-2xl shadow-orange-500/20 md:p-8 lg:grid-cols-[3fr_2fr] lg:gap-6 lg:p-12">
        <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-white/20 blur-3xl"></div>
        <div class="relative min-w-0 text-left [&_.code-block]:shadow-xl" innerHTML={current.html}></div>
        <div class="relative mt-3 flex min-h-64 flex-col overflow-hidden rounded-xl border bg-white text-black shadow-xl lg:mt-2 dark:bg-ink dark:text-white">
          <div class="flex items-center gap-1.5 border-b px-3 py-2">
            <span class="size-2.5 rounded-full bg-red-400"></span>
            <span class="size-2.5 rounded-full bg-yellow-400"></span>
            <span class="size-2.5 rounded-full bg-green-400"></span>
            <span class="ml-2 font-code text-xs opacity-50">live — running on Lux</span>
            <Link href={`/playground?example=${current.example}`} class="ml-auto flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs opacity-60 transition hover:bg-neutral-100 hover:opacity-100 dark:hover:bg-neutral-800">
              Edit <Icon name="arrowUpRight" />
            </Link>
          </div>
          <div class="flex flex-1 items-center justify-center p-6">
            {tab === 'counter' && <CounterDemo />}
            {tab === 'todo' && <TodoDemo />}
            {tab === 'binding' && <BindingDemo />}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto mt-20 grid max-w-6xl grid-cols-2 gap-px overflow-hidden rounded-2xl border bg-neutral-200 px-0 md:grid-cols-4 dark:bg-neutral-800">
    {stats.map((s) => (
      <div key={s.label} class="flex flex-col gap-1 bg-white px-6 py-6 dark:bg-ink">
        <span class="font-s2 text-3xl font-black md:text-4xl">{s.value}</span>
        <span class="text-sm text-neutral-500">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- Compiler output -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
      <p class="font-code text-xs tracking-widest text-orange-500 uppercase">Under the hood</p>
      <h2 class="font-s2 text-4xl md:text-5xl">Compiled to plain DOM code</h2>
      <p class="text-neutral-600 dark:text-neutral-400">
        The compiler reads your markup once and writes the code a careful human would: clone a template, wire one event, and bind each <code class="font-code">{'{expression}'}</code> to exactly the text node it fills.
      </p>
    </div>
    <div class="home-compare mt-10 grid items-stretch gap-4 lg:grid-cols-[minmax(0,5fr)_auto_minmax(0,7fr)]">
      <div class="min-w-0" innerHTML={source.html}></div>
      <div class="hidden items-center justify-center lg:flex">
        <span class="grid size-10 place-items-center rounded-full border bg-white text-orange-500 dark:bg-neutral-900"><Icon name="arrowRight" /></span>
      </div>
      <div class="min-w-0" innerHTML={compiled.html}></div>
    </div>
    <div class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
      <p class="flex gap-2 rounded-xl border p-4"><span class="text-orange-500"><Icon name="checkSm" /></span> <span><b>Reads become <code class="font-code">.get()</code></b>: the compiler tracks which names are states.</span></p>
      <p class="flex gap-2 rounded-xl border p-4"><span class="text-orange-500"><Icon name="checkSm" /></span> <span><b>One template clone</b> builds the static markup in a single call.</span></p>
      <p class="flex gap-2 rounded-xl border p-4"><span class="text-orange-500"><Icon name="checkSm" /></span> <span><b>Two text nodes</b> update when <code class="font-code">count</code> changes. Nothing else runs.</span></p>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto mt-32 max-w-400 px-6 md:px-10">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <h2 class="font-s2 text-4xl md:text-6xl">Everything you need,<br /><span class="text-neutral-400 dark:text-neutral-600">nothing you don't.</span></h2>
      <p class="max-w-md font-s2 text-sm text-neutral-500">
        A script, some markup and a scoped style: that's a component. Built-ins cover the hard parts: error boundaries, async data, portals, transitions and state-preserving reparenting.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {features.map((f) => (
        <Link key={f.title} href={f.href} class={['group block h-auto md:h-72', f.wide && 'md:col-span-2']}>
          <div class="h-full w-full overflow-hidden rounded-2xl border bg-neutral-100 p-1 transition group-hover:border-orange-400/60 dark:bg-neutral-900">
            <div class="relative flex h-full w-full flex-col gap-4 overflow-hidden rounded-xl border border-black/5 bg-white p-6 md:p-8 dark:border-white/5 dark:bg-ink">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-lg bg-orange-400/10 text-orange-500"><Icon name={f.icon} /></span>
                <h3 class="font-open text-xl font-bold">{f.title}</h3>
                <span class="ml-auto -translate-x-1 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-60"><Icon name="arrowUpRight" /></span>
              </div>
              <p class={['font-s2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400', f.wide && 'md:w-1/2']}>{f.text}</p>
              {f.points.length > 0 && (
                <div class="mt-auto flex flex-col gap-2 font-code text-xs">
                  {f.points.map((p) => (
                    <p key={p} class="flex items-center gap-2"><span class="text-orange-500"><Icon name="checkSm" /></span> {p}</p>
                  ))}
                </div>
              )}
              <span class={['pointer-events-none absolute -right-10 -bottom-10 opacity-[0.07] transition duration-500 group-hover:scale-110 group-hover:rotate-12 group-hover:opacity-20', !f.wide && 'hidden']} innerHTML={spark('size-56')}></span>
            </div>
          </div>
        </Link>
      ))}
    </div>
  </section>

  <!-- Examples -->
  <section class="mx-auto mt-32 max-w-400 px-6 md:px-10">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="font-code text-xs tracking-widest text-orange-500 uppercase">Examples</p>
        <h2 class="mt-2 font-s2 text-4xl md:text-5xl">See it, then change it.</h2>
      </div>
      <Link href="/examples" class="flex w-fit items-center gap-2 rounded-xl border px-4 py-2 text-sm font-bold transition hover:border-orange-400">
        All {examples.length} examples <Icon name="arrowRight" />
      </Link>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {showcase.map((e) => (
        <article key={e.slug} class="flex flex-col overflow-hidden rounded-2xl border bg-neutral-50 p-1.5 dark:bg-neutral-900/60">
          <div class="ex-preview relative h-80 overflow-hidden rounded-xl border border-black/5 bg-white p-5 dark:border-white/5 dark:bg-ink">
            <LiveDemo component={exampleComponent(e.slug)!} class="ex-zoom" />
          </div>
          <div class="flex items-center justify-between gap-2 px-3.5 py-3">
            <div>
              <Link href={`/examples/${e.slug}`} class="font-bold hover:underline">{e.title}</Link>
              <p class="text-xs text-neutral-500">{e.concepts.map((c) => c.label).join(' · ')}</p>
            </div>
            <Link href={`/playground?example=${e.slug}`} class="ex-action" aria-label={`Open ${e.title} in the playground`}><Icon name="play" /></Link>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Tools -->
  <section class="mx-auto mt-32 flex max-w-400 flex-col items-center justify-between gap-12 px-6 md:flex-row md:px-10">
    <div class="flex w-full flex-col justify-center md:w-130">
      <h2 class="mb-4 font-s2 text-4xl font-black md:text-5xl">
        Seamless with <br /> your favorite tools
      </h2>
      <p class="font-s2 text-neutral-600 dark:text-neutral-400">
        Lux runs on Vite for dev and builds, Bun for packages and tests, and renders on Node, Bun or Deno. Bring TypeScript and Tailwind: they just work.
      </p>
      <div class="mt-8 flex flex-wrap gap-2 text-sm">
        <Link href="/docs/tooling" class="flex items-center gap-1.5 rounded-lg border px-3 py-1.5 transition hover:border-orange-400"><img src="/icons/vscode.svg" width="16" height="16" alt="" /> VS Code extension</Link>
        <Link href="/docs/styles#tailwind-css" class="flex items-center gap-1.5 rounded-lg border px-3 py-1.5 transition hover:border-orange-400"><img src="/icons/tailwindcss.svg" width="16" height="16" alt="" /> Tailwind CSS</Link>
        <Link href="/docs/ssr" class="flex items-center gap-1.5 rounded-lg border px-3 py-1.5 transition hover:border-orange-400"><img src="/icons/nodejs.svg" width="16" height="16" alt="" /> SSR</Link>
      </div>
    </div>
    <div class="grid w-full max-w-80 grid-cols-3 gap-2">
      {tools.map((t) => (
        <div key={t} class="flex aspect-square items-center justify-center rounded-2xl border border-transparent p-5 transition hover:border-neutral-200 hover:bg-neutral-50 dark:hover:border-neutral-800 dark:hover:bg-neutral-900">
          <img src={`/icons/${t}.svg`} alt={t} width="52" height="52" class="transition duration-300 hover:scale-110" />
        </div>
      ))}
    </div>
  </section>

  <!-- Call to action -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="relative overflow-hidden rounded-3xl border bg-neutral-950 px-6 py-16 text-center text-white md:py-24">
      <div class="hero-glow pointer-events-none absolute inset-0"></div>
      <span class="animate-float pointer-events-none absolute top-10 left-[12%] opacity-70" innerHTML={spark('size-10')}></span>
      <span class="animate-float pointer-events-none absolute right-[14%] bottom-12 opacity-50 [animation-delay:-3s]" innerHTML={spark('size-14')}></span>
      <h2 class="relative font-s2 text-4xl md:text-6xl">Start building in a minute.</h2>
      <p class="relative mx-auto mt-4 max-w-xl text-neutral-400">Add Lux to a Vite project, or skip setup entirely and write your first component in the browser.</p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-2.5">
        <Link href="/docs/getting-started" class="flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 font-bold text-black transition hover:bg-neutral-200">Read the guide <Icon name="arrowRight" /></Link>
        <Link href="/playground" class="flex items-center gap-2 rounded-xl border border-white/20 px-5 py-2.5 font-bold transition hover:border-orange-400"><span class="text-orange-400"><Icon name="play" /></span> Open the playground</Link>
        <a href={GITHUB} target="_blank" rel="noreferrer" class="flex items-center gap-2 rounded-xl border border-white/20 px-5 py-2.5 font-bold transition hover:border-white/50"><Icon name="github" /> GitHub</a>
      </div>
    </div>
  </section>
</div>
<Footer />
