<script lang="ts">
  const { title } = props<{ title: string }>()

  // Local state that survives moves between columns.
  const note = state('')
  const seconds = state(0)
  const running = state(false)

  init(() => {
    const timer = setInterval(() => running.peek() && seconds.set(seconds.peek() + 1), 1000)
    return () => clearInterval(timer)
  })
</script>

<strong>{title}</strong>
<input bind:value={note} placeholder="Add a note…" />
<!-- The parent's grid places the timer next to its move buttons. -->
<button class={['timer', running && 'on']} onClick={() => running.set(!running)} aria-label={running ? 'Pause timer' : 'Start timer'}>
    <span class="dot"></span>{Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, '0')}
</button>

<style>
  strong,
  input {
    grid-column: 1 / -1;
  }
  strong {
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .timer {
    justify-self: start;
    gap: 0.3rem;
    min-height: 1.25rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    box-shadow: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--faint);
  }
  .timer.on {
    border-color: color-mix(in srgb, var(--success) 40%, transparent);
    color: var(--success);
  }
  .timer.on .dot {
    background: var(--success);
    animation: blink 1s steps(2) infinite;
  }
  input {
    width: 100%;
    min-height: 1.5rem;
    margin: 0.125rem 0 0.25rem;
    padding: 0;
    border-color: transparent;
    background: none;
    color: var(--muted);
    font-size: 0.75rem;
  }
  input:hover:not(:focus, :disabled) {
    border-color: transparent;
  }
  input:focus-visible {
    padding: 0 0.375rem;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
</style>
