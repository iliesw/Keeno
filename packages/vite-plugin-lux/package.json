{
  "name": "vite-plugin-lux",
  "version": "0.1.0",
  "description": "Vite plugin for Lux (.lx) single-file components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "lux-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts --target=node",
    "prepack": "bun run build"
  },
  "dependencies": { "@lux/compiler": "workspace:*" },
  "peerDependencies": { "vite": "^5.0.0 || ^6.0.0 || ^7.0.0" },
  "devDependencies": { "vite": "^5.4.11" }
}
