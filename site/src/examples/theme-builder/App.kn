<script lang="ts">
  // Three numbers drive the whole theme: the component writes them into CSS custom
  // properties, and the scoped styles below derive every color from those.
  const hue = state(262)
  const chroma = state(0.18)
  const radius = state(12)
  const dark = state(false)

  const PRESETS = [
    { name: 'Violet', hue: 262, chroma: 0.18 },
    { name: 'Ocean', hue: 220, chroma: 0.14 },
    { name: 'Forest', hue: 150, chroma: 0.13 },
    { name: 'Ember', hue: 35, chroma: 0.19 },
    { name: 'Mono', hue: 0, chroma: 0 },
  ]

  const vars = derived(() => `--h:${hue};--c:${chroma};--r:${radius}px`)
  const css = derived(
    () => `:root {\n  --primary: oklch(0.6 ${chroma} ${hue});\n  --primary-soft: oklch(0.95 ${(chroma / 4).toFixed(3)} ${hue});\n  --radius: ${radius}px;\n}`,
  )
  const copied = state(false)

  function copy() {
    navigator.clipboard?.writeText(css.peek())
    copied.set(true)
    setTimeout(() => copied.set(false), 1200)
  }
</script>

<div class="builder">
  <div class="controls">
    <div class="presets">
      {PRESETS.map((p) => (
        <button
          key={p.name}
          aria-label={p.name}
          title={p.name}
          class={{ on: hue === p.hue && chroma === p.chroma }}
          style={`background:oklch(0.6 ${p.chroma} ${p.hue})`}
          onClick={() => {
            hue.set(p.hue)
            chroma.set(p.chroma)
          }}
        ></button>
      ))}
    </div>
    <label>Hue <span>{hue}°</span><input type="range" min="0" max="360" bind:value={hue} class="hue" /></label>
    <label>Chroma <span>{chroma.toFixed(2)}</span><input type="range" min="0" max="0.3" step="0.01" bind:value={chroma} /></label>
    <label>Radius <span>{radius}px</span><input type="range" min="0" max="24" bind:value={radius} /></label>
    <label class="check"><input type="checkbox" bind:checked={dark} /> Dark preview</label>
  </div>

  <div class={['preview', dark && 'dark']} style={vars}>
    <div class="card">
      <span class="badge">New</span>
      <h3>Weekly report</h3>
      <p>Your project shipped 12 changes this week.</p>
      <div class="row">
        <button class="solid">View report</button>
        <button class="ghost">Later</button>
      </div>
    </div>
  </div>
</div>

<div class="code">
  <pre>{css}</pre>
  <button onClick={copy}>{copied ? 'Copied' : 'Copy'}</button>
</div>

<style>
  .builder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .controls {
    display: grid;
    gap: 0.5rem;
  }
  .presets {
    display: flex;
    gap: 6px;
  }
  .presets button {
    width: 1.5rem;
    min-height: 1.5rem;
    padding: 0;
    border: 2px solid var(--bg);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--border);
  }
  .presets button.on {
    box-shadow: 0 0 0 2px var(--fg);
  }
  label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  label span {
    font-family: var(--font-mono);
  }
  label input[type='range'] {
    grid-column: 1 / -1;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg);
    font-weight: 400;
    cursor: pointer;
  }
  .preview {
    --primary: oklch(0.6 var(--c) var(--h));
    --soft: oklch(0.95 calc(var(--c) / 4) var(--h));
    --page: oklch(0.985 calc(var(--c) / 10) var(--h));
    --text: oklch(0.25 calc(var(--c) / 4) var(--h));
    --panel: white;
    display: grid;
    place-items: center;
    padding: 1rem;
    border-radius: calc(var(--r) + 6px);
    background: var(--page);
    transition: background 0.2s;
  }
  .preview.dark {
    --soft: oklch(0.3 calc(var(--c) / 2) var(--h));
    --page: oklch(0.18 calc(var(--c) / 8) var(--h));
    --text: oklch(0.95 calc(var(--c) / 8) var(--h));
    --panel: oklch(0.23 calc(var(--c) / 6) var(--h));
  }
  .card {
    width: 100%;
    padding: 1rem;
    border-radius: var(--r);
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 8px 24px -12px oklch(0.4 var(--c) var(--h) / 0.4);
  }
  .card h3 {
    margin: 0.5rem 0 0.25rem;
  }
  .card p {
    margin: 0 0 0.875rem;
    opacity: 0.7;
    font-size: 0.85rem;
  }
  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--soft);
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .row {
    display: flex;
    gap: 0.375rem;
  }
  .row button {
    border-radius: calc(var(--r) * 0.6);
    font-size: 0.8rem;
  }
  .solid,
  .solid:hover:not(:disabled) {
    border-color: var(--primary);
    background: var(--primary);
    color: white;
  }
  .ghost,
  .ghost:hover:not(:disabled) {
    border-color: transparent;
    background: var(--soft);
    color: var(--primary);
  }
  .code {
    position: relative;
    margin-top: 0.75rem;
  }
  pre {
    margin: 0;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: var(--surface);
    font-size: 0.7rem;
    overflow-x: auto;
  }
  .code button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    min-height: 1.5rem;
    font-size: 0.7rem;
  }
</style>
