<script lang="ts">
  import { Link } from '@inflector/keeno-router'
  import Footer from '../components/Footer.kn'
  import Icon from '../components/Icon.kn'
  import LiveDemo from '../components/LiveDemo.kn'
  import Navbar from '../components/Navbar.kn'
  import Meta from '../components/Meta.kn'
  import { categories, exampleComponent, examples } from '../examples'

  const filter = state<string>('All', { url: { param: 'category', replace: true } })
  const shown = derived(() => (filter === 'All' ? examples : examples.filter((e) => e.category === filter)))

  // The call to action's figure: a Hairline figure (src/hairline/split.js), an editor beside its
  // live preview. The kernel and the figure load in the browser only, after the page is up.
  const splitHost = ref<HTMLDivElement>()
  init(() => {
    const stage = splitHost.current
    if (!stage) return
    let handle: { destroy(): void } | undefined
    let gone = false
    Promise.all([import('../hairline/kernel.js'), import('../hairline/split.js')]).then(([{ default: HL }, { split }]) => {
      if (gone) return
      HL.inject(document)
      const fig = split(HL)
      stage.setAttribute('data-hairline', fig.name)
      stage.setAttribute('role', 'img')
      stage.setAttribute('aria-label', fig.means)
      const svg = HL.mk('svg', { viewBox: '0 0 400 320', 'aria-hidden': 'true' }, stage)
      // The figure names what is under the pointer; the page does not show it.
      const read = { textContent: '' as string | null }
      handle = fig.mount({ stage, svg, read }, fig.range[1])
    })
    return () => {
      gone = true
      handle?.destroy()
    }
  })
</script>

<Meta title="Examples · Keeno" description={`${examples.length} small Keeno apps, running live: state, lists, forms, async data, transitions, portals and more.`} />
<Navbar />
<main class="mx-auto w-full max-w-400 px-6 pt-32 md:px-10">
  <section class="animate-fade-up flex flex-col items-start gap-4">
    <p class="flex items-center gap-2 font-mono text-xs tracking-widest text-neutral-500 uppercase"><Icon name="sparkles" /> {examples.length} live examples</p>
    <h1 class="text-5xl leading-none font-semibold tracking-[-0.045em] md:text-7xl">Examples</h1>
    <p class="max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
      Small, complete apps. Every one below is running right now: click around, then read the source or open it in the playground to change it.
    </p>
    <div class="mt-4 flex flex-wrap gap-1.5" role="tablist" aria-label="Category">
      {['All', ...categories].map((c) => (
        <button
          key={c}
          type="button"
          role="tab"
          aria-selected={filter === c}
          onClick={() => filter.set(c)}
          class={[
            'cursor-pointer rounded-full border px-3.5 py-1 text-sm transition',
            filter === c ? 'border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-black' : 'hover:bg-neutral-100 dark:hover:bg-neutral-900',
          ]}
        >
          {c}
          <span class="ml-1.5 opacity-50">{c === 'All' ? examples.length : examples.filter((e) => e.category === c).length}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {shown.map((e) => (
      <article key={e.slug} class="ex-card group flex flex-col overflow-hidden rounded-2xl border bg-neutral-50 p-1.5 transition hover:border-neutral-300 dark:bg-neutral-900/60 dark:hover:border-neutral-700">
        <div class="ex-preview relative h-72 overflow-hidden rounded-xl border border-black/5 bg-white p-5 dark:border-white/5 dark:bg-ink">
          <LiveDemo component={exampleComponent(e.slug)!} class="ex-zoom" />
          <span class="pointer-events-none absolute right-3 bottom-3 z-10 flex items-center gap-1.5 rounded-full border bg-white/80 px-2 py-0.5 font-mono text-[10px] tracking-wider uppercase backdrop-blur dark:bg-black/50">
            <span class="size-1.5 rounded-full bg-green-500 shadow-[0_0_6px] shadow-green-500"></span> Live
          </span>
        </div>
        <div class="flex flex-1 flex-col gap-2 px-3.5 pt-4 pb-3">
          <div class="flex items-center justify-between gap-2">
            <Link href={`/examples/${e.slug}`} class="text-lg font-bold hover:underline">{e.title}</Link>
            <span class="rounded-full bg-neutral-200/70 px-2 py-0.5 text-[11px] text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">{e.category}</span>
          </div>
          <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{e.description}</p>
          <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-3">
            {e.concepts.map((c) => (
              <span key={c.label} class="rounded-md border bg-white px-1.5 py-0.5 font-mono text-[11px] text-neutral-600 dark:bg-ink dark:text-neutral-300">{c.label}</span>
            ))}
            <div class="ml-auto flex gap-1">
              <Link href={`/examples/${e.slug}`} class="ex-action" aria-label={`Source of ${e.title}`}><Icon name="code" /></Link>
              <Link href={`/playground?example=${e.slug}`} class="ex-action" aria-label={`Open ${e.title} in the playground`}><Icon name="play" /></Link>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="relative mt-24 overflow-hidden rounded-2xl border bg-neutral-50 dark:bg-neutral-900/40">
    <div class="hero-grid pointer-events-none absolute inset-0"></div>
    <div class="relative grid items-center gap-10 p-6 md:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 lg:p-14">
      <div class="flex flex-col items-start gap-5">
        <h2 class="text-3xl leading-[1.05] font-semibold tracking-[-0.04em] md:text-5xl">Have an idea?<br /><span class="text-neutral-500">Build it in the browser.</span></h2>
        <p class="max-w-md text-neutral-600 dark:text-neutral-400">Start from any example above, or from a blank file. No install, no setup.</p>
        <div class="mt-2 flex flex-wrap gap-2.5">
          <Link href="/playground" class="flex h-10 items-center gap-2 rounded-full bg-neutral-900 px-5 text-sm font-medium text-white transition hover:bg-neutral-700 dark:bg-white dark:text-black dark:hover:bg-neutral-200"><Icon name="play" /> Open the playground</Link>
          <Link href="/docs/getting-started" class="flex h-10 items-center gap-2 rounded-full border bg-white px-5 text-sm font-medium transition hover:bg-neutral-50 dark:bg-ink dark:hover:bg-neutral-900">Read the guide <Icon name="arrowRight" /></Link>
        </div>
      </div>
      <div>
        <div ref={splitHost} class="cta-figure aspect-[5/4] w-full scale-[1.25] lg:scale-[1.4]"></div>
      </div>
    </div>
  </section>
</main>
<Footer />

<style>
  /* The Hairline figure fills its plates with the section's colour. */
  .cta-figure {
    --hairline-plate: var(--bg);
  }
</style>
