<script lang="ts">
  import Card from './Card.lx'
  import Reparenting from './Reparenting.lx'
  import Board from './Board.lx'

  const count = state(0)
  const dark = state(false)
</script>

<main class={['min-h-screen p-8 font-sans', dark ? 'bg-slate-900 text-white' : 'bg-white text-slate-900']}>
  <h1 class="text-3xl font-bold text-brand">Lux + Tailwind</h1>
  <Card title="Counter">
    <p class="text-lg">Count: <span class="font-mono tabular-nums">{count}</span></p>
    <div class="mt-4 flex gap-2">
      <button class="btn" onClick={() => count.set(count - 1)}>-1</button>
      <button class="btn" onClick={() => count.set(count + 1)}>+1</button>
      <button class="btn btn-ghost" onClick={() => dark.set(!dark)}>{dark ? 'Light' : 'Dark'}</button>
    </div>
    {count >= 5 && <p class="mt-4 text-sm text-amber-600">That's a big number!</p>}
  </Card>
  <Reparenting />
  <Board />
</main>

<style>
  /* `@apply` works in any component; the plugin adds the `@reference` to src/app.css for you. */
  .btn {
    @apply rounded-lg bg-brand px-4 py-2 font-medium text-white;
    &:hover {
      @apply brightness-110;
    }
  }
  .btn-ghost {
    @apply bg-transparent text-brand ring-1 ring-brand;
  }
</style>
