<script lang="ts">
  import { Portal, Transition, type Children } from '@inflector/keeno'

  const { open, title, onClose, children } = props<{
    open: boolean
    title: string
    onClose: () => void
    children?: Children
  }>()

  init(() => {
    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onClose()
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  })
</script>

<!-- Rendered at the end of <body>, so no parent's overflow or z-index can clip it. -->
<Portal target="body">
  <Transition name="modal">
    {open && (
      <div class="backdrop" onClick={onClose}>
        <div class="dialog" role="dialog" aria-modal="true" aria-label={title} onClick={(e: MouseEvent) => e.stopPropagation()}>
          <header>
            <h2>{title}</h2>
            <button class="close" aria-label="Close" onClick={onClose}>✕</button>
          </header>
          <div class="body">{children?.()}</div>
          <footer>
            <button class="done" onClick={onClose}>Done</button>
          </footer>
        </div>
      </div>
    )}
  </Transition>
</Portal>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(4px);
  }
  .dialog {
    width: min(100%, 380px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    background: var(--bg);
    color: var(--fg);
    font-size: 14px;
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.4);
  }
  .body {
    padding: 0 1.25rem 1.25rem;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem 1rem 1.25rem;
  }
  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  button {
    font: inherit;
    font-weight: 500;
    color: inherit;
    cursor: pointer;
  }
  .close {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 0.375rem;
    background: none;
    color: var(--muted);
  }
  .close:hover {
    background: var(--hover);
    color: var(--fg);
  }
  footer {
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .done {
    min-height: 2rem;
    padding: 0 0.875rem;
    border: 1px solid var(--fg);
    border-radius: 0.5rem;
    background: var(--fg);
    color: var(--bg);
  }
  .done:hover {
    background: color-mix(in srgb, var(--fg) 85%, var(--bg));
  }
  .modal-enter-active,
  .modal-leave-active {
    transition: opacity 0.2s ease;
  }
  .modal-enter-active .dialog,
  .modal-leave-active .dialog {
    transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  .modal-enter-from,
  .modal-leave-to {
    opacity: 0;
  }
  .modal-enter-from .dialog,
  .modal-leave-to .dialog {
    transform: translateY(16px) scale(0.97);
  }
</style>
