<script lang="ts">
  // The hero background: a WebGL dot field. Dots swell where a slow noise field and a wave pass,
  // and around the pointer. Renders one still frame with reduced motion, pauses while off screen
  // or in a hidden tab, and leaves nothing behind without WebGL.
  const canvas = ref<HTMLCanvasElement>()

  const VERTEX = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`
  const FRAGMENT = `
    precision mediump float;
    uniform vec2 uSize;     // canvas size in CSS pixels
    uniform float uDpr;
    uniform float uTime;
    uniform vec2 uMouse;    // CSS pixels, origin bottom-left
    uniform float uMouseOn; // 0..1
    uniform vec3 uColor;

    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }

    void main() {
      float cell = 22.0;
      vec2 px = gl_FragCoord.xy / uDpr;
      vec2 id = floor(px / cell);
      vec2 center = (id + 0.5) * cell;
      vec2 local = px - center;

      // Drifting noise, plus a wave rolling out from the top center.
      float n = noise(id * 0.11 + vec2(uTime * 0.12, -uTime * 0.08));
      n = smoothstep(0.3, 0.9, n);
      vec2 origin = vec2(uSize.x * 0.5, uSize.y * 0.78);
      float wave = 0.5 + 0.5 * sin(distance(center, origin) / 46.0 - uTime * 1.1);
      float pointer = uMouseOn * (1.0 - smoothstep(0.0, 180.0, distance(center, uMouse)));

      float energy = clamp(n * 0.7 + wave * 0.25 + pointer, 0.0, 1.0);
      float radius = mix(0.8, 3.0, energy);
      float disc = 1.0 - smoothstep(radius - 0.7, radius + 0.7, length(local));

      // Fade out toward the edges, strongest around the headline.
      vec2 q = (center - vec2(uSize.x * 0.5, uSize.y * 0.6)) / uSize;
      float fade = 1.0 - smoothstep(0.1, 0.62, length(q * vec2(1.0, 1.3)));

      float alpha = disc * (0.1 + 0.65 * energy) * fade;
      gl_FragColor = vec4(uColor * alpha, alpha);
    }
  `

  init(() => {
    const el = canvas.current
    const gl = el?.getContext('webgl', { premultipliedAlpha: true, antialias: false, alpha: true })
    if (!el || !gl) return

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!
      gl.shaderSource(s, src)
      gl.compileShader(s)
      return s
    }
    const program = gl.createProgram()!
    gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX))
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT))
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return
    gl.useProgram(program)

    const buffer = gl.createBuffer()
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW)
    const loc = gl.getAttribLocation(program, 'p')
    gl.enableVertexAttribArray(loc)
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)
    gl.enable(gl.BLEND)
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA)

    const u = (name: string) => gl.getUniformLocation(program, name)
    const uSize = u('uSize')
    const uDpr = u('uDpr')
    const uTime = u('uTime')
    const uMouse = u('uMouse')
    const uMouseOn = u('uMouseOn')
    const uColor = u('uColor')

    let width = 0
    let height = 0
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      width = el.clientWidth
      height = el.clientHeight
      el.width = Math.round(width * dpr)
      el.height = Math.round(height * dpr)
      gl.viewport(0, 0, el.width, el.height)
      gl.uniform2f(uSize, width, height)
      gl.uniform1f(uDpr, dpr)
    }
    const setColor = () => {
      const dark = document.documentElement.classList.contains('dark')
      gl.uniform3f(uColor, ...((dark ? [0.93, 0.93, 0.93] : [0.09, 0.09, 0.09]) as [number, number, number]))
    }

    // The pointer is eased, so the bulge glides after it.
    const mouse = { x: 0, y: 0, tx: 0, ty: 0, on: 0, ton: 0 }
    const onMove = (e: PointerEvent) => {
      const r = el.getBoundingClientRect()
      mouse.tx = e.clientX - r.left
      mouse.ty = r.bottom - e.clientY
      mouse.ton = e.clientY >= r.top && e.clientY <= r.bottom ? 1 : 0
      if (!mouse.on) {
        mouse.x = mouse.tx
        mouse.y = mouse.ty
      }
    }
    const onLeave = () => (mouse.ton = 0)

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let frame = 0
    let visible = true
    const start = performance.now()
    const draw = () => {
      mouse.x += (mouse.tx - mouse.x) * 0.12
      mouse.y += (mouse.ty - mouse.y) * 0.12
      mouse.on += (mouse.ton - mouse.on) * 0.08
      gl.uniform1f(uTime, still ? 4 : (performance.now() - start) / 1000)
      gl.uniform2f(uMouse, mouse.x, mouse.y)
      gl.uniform1f(uMouseOn, still ? 0 : mouse.on)
      gl.clearColor(0, 0, 0, 0)
      gl.clear(gl.COLOR_BUFFER_BIT)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
    }
    const loop = () => {
      // the theme switch's circle runs on the main thread: leave it the frames
      if (!document.documentElement.classList.contains('theme-switching')) draw()
      frame = visible && !document.hidden && !still ? requestAnimationFrame(loop) : 0
    }
    const wake = () => {
      if (!frame && visible && !document.hidden && !still) frame = requestAnimationFrame(loop)
    }

    resize()
    setColor()
    draw()
    wake()

    const sizes = new ResizeObserver(() => {
      resize()
      draw()
    })
    sizes.observe(el)
    const theme = new MutationObserver(() => {
      setColor()
      draw()
    })
    theme.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
    const seen = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      wake()
    })
    seen.observe(el)
    window.addEventListener('pointermove', onMove, { passive: true })
    document.addEventListener('pointerleave', onLeave)
    document.addEventListener('visibilitychange', wake)

    return () => {
      cancelAnimationFrame(frame)
      sizes.disconnect()
      theme.disconnect()
      seen.disconnect()
      window.removeEventListener('pointermove', onMove)
      document.removeEventListener('pointerleave', onLeave)
      document.removeEventListener('visibilitychange', wake)
      gl.getExtension('WEBGL_lose_context')?.loseContext()
    }
  })
</script>

<canvas ref={canvas} class="hero-canvas pointer-events-none absolute inset-0 size-full" aria-hidden="true"></canvas>

<style>
  .hero-canvas {
    animation: canvas-in 1.6s ease-out both;
  }
  @keyframes canvas-in {
    from {
      opacity: 0;
    }
  }
</style>
