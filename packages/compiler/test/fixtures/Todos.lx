<script lang="ts">
  import Item from './Item.lx'
  type Todo = { id: number; text: string; done: boolean }
  const { log } = props()
  const todos = state<Todo[]>([])
  const draft = state('')
  let nextId = 1

  function add() {
    if (!draft) return
    todos.set([...todos, { id: nextId++, text: draft, done: false }])
    draft.set('')
  }
  const toggle = (id: number) => todos.set(todos.map((t) => (t.id === id ? { ...t, done: !t.done } : t)))
  const remove = (id: number) => todos.set(todos.filter((t) => t.id !== id))
  const left = () => todos.filter((t) => !t.done).length
</script>

<input class="draft" bind:value={draft} />
<button class="add" onClick={add}>add</button>
<ul>
  {todos.map((t) => <Item key={t.id} todo={t} onToggle={toggle} onRemove={remove} log={log} />)}
</ul>
<p class="left">{left()} left</p>
