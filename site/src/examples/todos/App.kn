<script lang="ts">
  import TodoItem from './TodoItem.kn'

  type Todo = { id: number; text: string; done: boolean }
  type Filter = 'all' | 'active' | 'done'

  // Saved to localStorage (and synced across tabs) under "keeno-example-todos".
  const todos = state<Todo[]>(
    [
      { id: 1, text: 'Learn state() and derived()', done: true },
      { id: 2, text: 'Build something with Keeno', done: false },
    ],
    { persist: 'keeno-example-todos' },
  )
  const draft = state('')
  const filter = state<Filter>('all')

  const visible = derived(() => todos.filter((t) => filter === 'all' || (filter === 'done') === t.done))
  const left = derived(() => todos.filter((t) => !t.done).length)

  function add(e: SubmitEvent) {
    e.preventDefault()
    const text = draft.trim()
    if (!text) return
    // Updates are immutable: create a new array instead of pushing.
    todos.set([...todos, { id: Date.now(), text, done: false }])
    draft.set('')
  }
  const toggle = (id: number) => todos.set(todos.map((t) => (t.id === id ? { ...t, done: !t.done } : t)))
  const remove = (id: number) => todos.set(todos.filter((t) => t.id !== id))
  const clearDone = () => todos.set(todos.filter((t) => !t.done))
</script>

<form onSubmit={add}>
  <input bind:value={draft} placeholder="What needs doing?" />
  <button type="submit" class="add" disabled={!draft.trim()}>Add</button>
</form>

<ul>
  {visible.map((todo) => (
    <TodoItem key={todo.id} todo={todo} onToggle={toggle} onRemove={remove} />
  ))}
</ul>
{visible.length === 0 && <p class="empty">Nothing here.</p>}

<footer>
  <span>{left} {left === 1 ? 'item' : 'items'} left</span>
  <div class="filters">
    {(['all', 'active', 'done'] as const).map((f) => (
      <button key={f} class={{ selected: filter === f }} onClick={() => filter.set(f)}>{f}</button>
    ))}
  </div>
  <button class="link" onClick={clearDone} disabled={left === todos.length}>Clear done</button>
</footer>

<style>
  form {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    min-width: 0;
  }
  .add {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
  .add:hover:not(:disabled) {
    border-color: var(--fg);
    background: color-mix(in srgb, var(--fg) 85%, var(--bg));
  }
  ul {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  ul:empty {
    display: none;
  }
  .empty {
    margin: 0.75rem 0;
    padding: 1.25rem;
    border: 1px dashed var(--border);
    border-radius: 0.75rem;
    color: var(--muted);
    text-align: center;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .filters {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .filters button {
    min-height: 1.5rem;
    padding: 0 0.6rem;
    border: none;
    border-radius: 0.375rem;
    background: none;
    box-shadow: none;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: capitalize;
  }
  .filters button.selected {
    background: var(--surface);
    color: var(--fg);
  }
  .link {
    min-height: 1.5rem;
    padding: 0 0.25rem;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .link:hover:not(:disabled) {
    background: none;
    color: var(--fg);
  }
</style>
