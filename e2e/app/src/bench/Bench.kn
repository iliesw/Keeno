<script lang="ts">
  // The js-framework-benchmark table: create, replace, update, select, swap, remove, clear.
  import { State } from '@inflector/keeno'
  type Row = { id: number; label: State<string> }
  const A = ['pretty', 'large', 'big', 'small', 'tall', 'short', 'long', 'handsome', 'plain', 'quaint', 'clean', 'elegant', 'easy', 'angry', 'crazy', 'helpful', 'mushy', 'odd', 'unsightly', 'adorable', 'important', 'inexpensive', 'cheap', 'expensive', 'fancy']
  const C = ['red', 'yellow', 'blue', 'green', 'pink', 'brown', 'purple', 'brown', 'white', 'black', 'orange']
  const N = ['table', 'chair', 'house', 'bbq', 'desk', 'car', 'pony', 'cookie', 'sandwich', 'burger', 'pizza', 'mouse', 'keyboard']
  const pick = (a: string[]) => a[Math.round(Math.random() * 1000) % a.length]
  let nextId = 1
  const build = (count: number): Row[] =>
    Array.from({ length: count }, () => ({ id: nextId++, label: new State(`${pick(A)} ${pick(C)} ${pick(N)}`) }))

  const rows = state<Row[]>([])
  const selected = state(0)

  const run = () => rows.set(build(1000))
  const runLots = () => rows.set(build(10000))
  const add = () => rows.set([...rows, ...build(1000)])
  const updateEvery10th = () => {
    for (let i = 0; i < rows.length; i += 10) rows.get()[i].label.set(rows.get()[i].label.peek() + ' !!!')
  }
  const clear = () => rows.set([])
  const swapRows = () => {
    if (rows.length > 998) {
      const next = rows.slice()
      const tmp = next[1]
      next[1] = next[998]
      next[998] = tmp
      rows.set(next)
    }
  }
  const remove = (id: number) => rows.set(rows.filter((r) => r.id !== id))
</script>

<div class="bench">
  <button id="run" onClick={run}>Create 1,000 rows</button>
  <button id="runlots" onClick={runLots}>Create 10,000 rows</button>
  <button id="add" onClick={add}>Append 1,000 rows</button>
  <button id="update" onClick={updateEvery10th}>Update every 10th row</button>
  <button id="clear" onClick={clear}>Clear</button>
  <button id="swaprows" onClick={swapRows}>Swap rows</button>
  <table>
    <tbody id="tbody">
      {rows.map((row) => (
        <tr key={row.id} class={selected === row.id ? 'danger' : ''}>
          <td class="col-md-1">{row.id}</td>
          <td class="col-md-4"><a onClick={() => selected.set(row.id)}>{row.label.get()}</a></td>
          <td class="col-md-1"><a class="remove" onClick={() => remove(row.id)}>x</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
