<script lang="ts">
  import { navigate } from '@inflector/lux-router'
  import Icon from './Icon.lx'
  import { loadIndex, search, searchOpen, type Entry } from '../search'

  const query = state('')
  const entries = state<Entry[]>([])
  const selected = state(0)
  const results = derived(() => search(entries, query))
  const input = ref<HTMLInputElement>()

  const suggestions = [
    { label: 'Quick start', url: '/docs/getting-started' },
    { label: 'state() and derived()', url: '/docs/reactivity' },
    { label: 'Keyed lists', url: '/docs/templates' },
    { label: 'Built-in components', url: '/docs/built-ins' },
    { label: 'Examples', url: '/examples' },
    { label: 'Playground', url: '/playground' },
  ]

  function open() {
    searchOpen.set(true)
    loadIndex().then((e) => entries.set(e))
    requestAnimationFrame(() => input.current?.focus())
  }
  function close() {
    searchOpen.set(false)
    query.set('')
    selected.set(0)
  }
  function go(url: string) {
    close()
    navigate(url)
  }

  update(() => selected.set(0), [query])
  update(() => {
    if (searchOpen.get()) open()
  })

  function onKey(e: KeyboardEvent) {
    const list = results.peek()
    if (e.key === 'ArrowDown') {
      e.preventDefault()
      selected.set(Math.min(selected.peek() + 1, list.length - 1))
    } else if (e.key === 'ArrowUp') {
      e.preventDefault()
      selected.set(Math.max(selected.peek() - 1, 0))
    } else if (e.key === 'Enter' && list[selected.peek()]) {
      go(list[selected.peek()].url)
    } else if (e.key === 'Escape') {
      close()
    }
    requestAnimationFrame(() => document.querySelector('.search-hit[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' }))
  }

  init(() => {
    const onGlobalKey = (e: KeyboardEvent) => {
      const typing = (e.target as HTMLElement).closest?.('input, textarea, [contenteditable], .cm-editor')
      if ((e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault()
        searchOpen.get() ? close() : open()
      }
    }
    window.addEventListener('keydown', onGlobalKey)
    return () => window.removeEventListener('keydown', onGlobalKey)
  })

  const kindIcon = (kind: Entry['kind'], heading: string) => (kind === 'example' ? 'play' : kind === 'page' ? 'sparkles' : heading ? 'hash' : 'file')
</script>

{searchOpen.get() && (
  <div class="fixed inset-0 z-[100] flex items-start justify-center bg-black/40 px-4 pt-[12vh] backdrop-blur-sm" onClick={close}>
    <div
      class="animate-pop flex max-h-[70vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border bg-white shadow-2xl dark:bg-neutral-900"
      role="dialog"
      aria-modal="true"
      aria-label="Search"
      onClick={(e: MouseEvent) => e.stopPropagation()}
    >
      <div class="flex items-center gap-3 border-b px-4">
        <span class="opacity-50"><Icon name="search" /></span>
        <input
          ref={input}
          bind:value={query}
          onKeyDown={onKey}
          placeholder="Search the docs and examples…"
          class="h-14 flex-1 bg-transparent text-base outline-none placeholder:text-neutral-400"
          aria-label="Search"
          role="combobox"
          aria-expanded={results.length > 0}
          aria-controls="search-results"
          spellcheck="false"
          autocomplete="off"
        />
        <kbd class="search-kbd">esc</kbd>
      </div>
      <div id="search-results" class="overflow-y-auto p-2" role="listbox">
        {!query.trim() ? (
          <div class="p-2">
            <p class="px-2 pb-2 text-xs font-bold tracking-wider text-neutral-500 uppercase">Jump to</p>
            <div class="grid grid-cols-2 gap-1">
              {suggestions.map((s) => (
                <button key={s.url} type="button" onClick={() => go(s.url)} class="flex cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2 text-left text-sm hover:bg-neutral-100 dark:hover:bg-neutral-800">
                  <span class="opacity-40"><Icon name="corner" /></span>
                  {s.label}
                </button>
              ))}
            </div>
          </div>
        ) : results.length === 0 ? (
          <p class="px-4 py-10 text-center text-sm text-neutral-500">{entries.length ? `No results for “${query}”` : 'Loading…'}</p>
        ) : (
          results.map((r, i) => (
            <button
              key={r.url}
              type="button"
              role="option"
              aria-selected={selected === i}
              onMouseMove={() => selected.set(i)}
              onClick={() => go(r.url)}
              class={['search-hit flex w-full cursor-pointer items-start gap-3 rounded-xl px-3 py-2.5 text-left', selected === i && 'bg-neutral-100 dark:bg-neutral-800']}
            >
              <span class={['mt-0.5 grid size-7 flex-none place-items-center rounded-lg border', selected === i ? 'border-orange-400 text-orange-500' : 'opacity-60']}>
                <Icon name={kindIcon(r.kind, r.heading)} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-1.5 text-sm font-semibold">
                  {r.heading ? (
                    <span class="truncate"><span class="font-normal text-neutral-500">{r.page} › </span>{r.heading}</span>
                  ) : (
                    <span class="truncate">{r.page}</span>
                  )}
                  {r.kind === 'example' && <span class="rounded bg-orange-400/15 px-1.5 text-[10px] font-bold text-orange-500 uppercase">Example</span>}
                </span>
                <span class="mt-0.5 line-clamp-2 block text-xs leading-relaxed text-neutral-500">
                  {r.snippet.map((p, j) => <span key={j} class={p.hit ? 'hit' : ''}>{p.text}</span>)}
                </span>
              </span>
            </button>
          ))
        )}
      </div>
      <div class="flex items-center gap-4 border-t px-4 py-2 text-xs text-neutral-500">
        <span class="flex items-center gap-1"><kbd class="search-kbd">↑</kbd><kbd class="search-kbd">↓</kbd> navigate</span>
        <span class="flex items-center gap-1"><kbd class="search-kbd">↵</kbd> open</span>
        <span class="ml-auto">Press <kbd class="search-kbd">/</kbd> anywhere</span>
      </div>
    </div>
  </div>
)}
