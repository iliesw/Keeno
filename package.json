{
  "name": "lux-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e/app"
  ],
  "scripts": {
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "test:e2e:install": "bunx playwright install chromium",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun run scripts/build.ts",
    "predev": "bun run build",
    "dev": "bun run --cwd examples/todo dev",
    "docs:llms": "bun run scripts/build-llms.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
