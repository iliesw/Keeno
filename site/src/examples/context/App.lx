<script lang="ts">
  import { provide } from '@inflector/lux'
  import Panel from './Panel.lx'
  import Picker from './Picker.lx'
  import { AccentContext, type Accent } from './theme'

  // Everything rendered inside this component can inject() the accent, however deep.
  const accent = state<Accent>('orange')
  provide(AccentContext, accent)
</script>

