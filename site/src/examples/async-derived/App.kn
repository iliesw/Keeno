<script lang="ts">
  import { ErrorBoundary, Loading, pending } from '@inflector/keeno'
  import { fetchUser } from './api'

  const id = state(1)
  const fail = state(false)

  // Runs again when `id` or `fail` changes; the current card stays until the new one arrives.
  const user = derived(async () => fetchUser(id, fail))
</script>

<div class="bar">
  <button disabled={id <= 1} onClick={() => id.set(id - 1)}>← Prev</button>
  <span>User #{id}</span>
  <button disabled={id >= 5} onClick={() => id.set(id + 1)}>Next →</button>
  <label><input type="checkbox" bind:checked={fail} /> Make it fail</label>
</div>

<ErrorBoundary
  fallback={(error, reset) => (
    <div class="card error">
      <p>⚠️ {String(error)}</p>
      <button onClick={() => (fail.set(false), user.refresh(), reset())}>Retry</button>
    </div>
  )}
>
  <Loading
    fallback={() => (
      <div class="card skeleton">
        <div class="avatar"></div>
        <div class="lines"><span></span><span></span></div>
      </div>
    )}
  >
    <div class={['card', pending(() => user) && 'stale']}>
      <div class="avatar" style={`background:${user.color}`}>{user.name[0]}</div>
      <div>
        <h3>{user.name}</h3>
        <p>{user.role} · {user.city}</p>
      </div>
      <button class="reload" onClick={() => user.refresh()}>↻</button>
    </div>
  </Loading>
</ErrorBoundary>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .bar span {
    min-width: 5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .bar label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 88px;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg);
    transition: opacity 0.2s;
  }
  .card h3 {
    margin: 0;
  }
  .card p {
    margin: 0;
    color: var(--muted);
  }
  .stale {
    opacity: 0.55;
  }
  .reload {
    margin-left: auto;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: white;
    font-size: 1.3rem;
    font-weight: 600;
    background: var(--surface);
  }
  .lines {
    display: grid;
    gap: 8px;
    flex: 1;
  }
  .lines span {
    height: 12px;
    border-radius: 6px;
    background: var(--surface);
  }
  .lines span:last-child {
    width: 60%;
  }
  .skeleton {
    animation: pulse 0.8s ease-in-out infinite alternate;
  }
  .error {
    justify-content: space-between;
    border-color: color-mix(in srgb, var(--danger) 40%, transparent);
    background: color-mix(in srgb, var(--danger) 6%, transparent);
  }
  .error p {
    color: var(--danger);
  }
  @keyframes pulse {
    to {
      opacity: 0.45;
    }
  }
</style>
