<script lang="ts">
  import { keyedReparentable } from '@inflector/lux'
  import Widget from './Widget.lx'

  type Column = 'todo' | 'doing' | 'done'
  const columns: Column[] = ['todo', 'doing', 'done']
  const tasks = state([
    { id: 1, title: 'Write docs', column: 'todo' as Column },
    { id: 2, title: 'Fix bug', column: 'doing' as Column },
    { id: 3, title: 'Ship it', column: 'done' as Column },
  ])

  // One live card per task id, owned by the board: moving a task between columns re-creates
  // its <li>, but the card inside keeps running.
  const card = keyedReparentable((id: number) => <Widget label={tasks.get().find((t) => t.id === id)?.title} />)

  function shift(id: number, by: number) {
    tasks.set(
      tasks.map((t) => {
        if (t.id !== id) return t
        const i = Math.min(columns.length - 1, Math.max(0, columns.indexOf(t.column) + by))
        return { ...t, column: columns[i] }
      }),
    )
  }
</script>

<section class="mt-8 max-w-5xl">
  <h2 class="text-xl font-bold">Kanban (keyedReparentable)</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {columns.map((column) => (
      <div key={column} class="rounded-xl bg-slate-100 p-3 text-slate-900">
        <h3 class="mb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">{column}</h3>
        <ul class="flex flex-col gap-3">
          {tasks.filter((t) => t.column === column).map((t) => (
            <li key={t.id}>
              {card(t.id)}
              <div class="mt-1 flex justify-between">
                <button class="text-sm text-brand disabled:opacity-30" disabled={column === 'todo'} onClick={() => shift(t.id, -1)}>← move</button>
                <button class="text-sm text-brand disabled:opacity-30" disabled={column === 'done'} onClick={() => shift(t.id, 1)}>move →</button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
