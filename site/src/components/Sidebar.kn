<script lang="ts">
  import { Link } from '@inflector/keeno-router'
  import Icon from './Icon.kn'
  import { nav } from '../docs'
  import type { IconName } from '../icons'

  const quick: { href: string; label: string; icon: IconName }[] = [
    { href: '/docs/cheatsheet', label: 'Cheatsheet', icon: 'file' },
    { href: '/examples', label: 'Examples', icon: 'grid' },
    { href: '/playground', label: 'Playground', icon: 'play' },
  ]

  const item =
    'relative flex items-center rounded-md px-2 py-1.5 text-sm text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white [&.active]:bg-neutral-100 [&.active]:font-medium [&.active]:text-neutral-900 dark:[&.active]:bg-neutral-900 dark:[&.active]:text-white'
</script>

<nav class="flex w-60 flex-col gap-6 pb-8" aria-label="Documentation">
  <div class="flex flex-col gap-0.5">
    {quick.map((q) => (
      <Link key={q.href} href={q.href} exact class={`group gap-2.5 font-medium ${item}`}>
        <span class="grid size-6 place-items-center rounded-md border bg-white text-neutral-500 shadow-xs transition-colors group-hover:text-neutral-900 dark:bg-neutral-950 dark:group-hover:text-white [&_svg]:size-3.5">
          <Icon name={q.icon} />
        </span>
        {q.label}
      </Link>
    ))}
  </div>
  {nav.map((group) => (
    <div key={group.title} class="flex flex-col gap-0.5">
      <p class="mb-1 px-2 text-xs font-medium text-neutral-500">{group.title}</p>
      {group.items.map((it) => (
        <Link key={it.slug} href={`/docs/${it.slug}`} exact class={item}>
          {it.title}
        </Link>
      ))}
    </div>
  ))}
</nav>
