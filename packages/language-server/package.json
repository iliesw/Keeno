{
  "name": "@inflector/lux-language-server",
  "version": "0.1.0",
  "description": "Volar-based language server for Lux (.lx) components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliesw/Lux.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/iliesw/Lux/tree/main/packages/language-server#readme",
  "bugs": {
    "url": "https://github.com/iliesw/Lux/issues"
  },
  "keywords": [
    "lux",
    "language-server",
    "volar",
    "lsp",
    "lx"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "lux-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "lux-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts --target=node",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@inflector/lux-compiler": "workspace:*",
    "@volar/language-core": "~2.4.28",
    "@volar/language-server": "~2.4.28",
    "@volar/typescript": "~2.4.28",
    "volar-service-css": "~0.0.71",
    "volar-service-typescript": "~0.0.71",
    "vscode-css-languageservice": "~6.3.10",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@volar/test-utils": "~2.4.28",
    "@inflector/lux": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
