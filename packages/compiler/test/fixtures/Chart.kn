<script lang="ts">
  import Dot from './Dot.kn'

  const points = state([
    { id: 1, x: 10, y: 20 },
    { id: 2, x: 30, y: 40 },
  ])
  const showAxis = state(true)
  const label = state('Chart')
</script>

<svg width="100" height="100" viewBox="0 0 100 100">
  {showAxis && <line class="axis" x1="0" y1="90" x2="100" y2="90" />}
  <g class="points">
    {points.map((p) => <Dot key={p.id} x={p.x} y={p.y} />)}
  </g>
  <text x="5" y="10">{label}</text>
  <foreignObject width="100" height="20">
    {showAxis && <p class="html">html inside svg</p>}
  </foreignObject>
</svg>
<button class="add" onClick={() => points.set([...points, { id: points.length + 1, x: 50, y: 60 }])}>add</button>
<button class="axis-toggle" onClick={() => showAxis.set(!showAxis)}>axis</button>
