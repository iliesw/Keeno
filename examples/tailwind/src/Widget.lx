<script lang="ts">
  // Everything here is state that a re-created component would lose: the running stopwatch,
  // what you typed, the iframe's own counter, and the spinner's animation.
  const { label = 'Widget' } = props<{ label?: string }>()
  const seconds = state(0)
  const note = state('')
  const created = new Date().toLocaleTimeString()

  init(() => {
    const id = setInterval(() => seconds.set(seconds + 1), 1000)
    return () => clearInterval(id)
  })

  const frame = `<body style="margin:0;font:13px system-ui;display:grid;place-items:center;height:100vh">
    <button onclick="this.textContent = 'iframe clicks: ' + (++window.n || (window.n = 1))">iframe clicks: 0</button>
  </body>`
</script>

<div class="rounded-xl bg-white p-4 text-slate-900 shadow-lg ring-1 ring-black/10">
  <div class="flex cursor-grab items-center gap-2" draggable="true">
    <span class="size-4 animate-spin rounded-full border-2 border-brand border-t-transparent"></span>
    <strong>{label}</strong>
    <span class="ml-auto font-mono text-sm tabular-nums">{seconds}s</span>
  </div>
  <p class="mt-1 text-xs text-slate-500">created at {created}</p>
  <input class="mt-3 w-full rounded-md border border-slate-300 px-2 py-1 text-sm" placeholder="Type, then move me" bind:value={note} />
  <iframe class="mt-3 h-12 w-full rounded-md bg-slate-50" srcdoc={frame} title="iframe state"></iframe>
</div>
