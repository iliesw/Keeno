<script lang="ts">
  import Badge from './Badge.kn'
  import Dot from './Dot.kn'

  const points = state([
    { id: 1, x: 10, y: 20 },
    { id: 2, x: 30, y: 40 },
  ])
  const showAxis = state(true)
</script>

<svg class="chart" width="100" height="100" viewBox="0 0 100 100">
  {showAxis && <line class="axis" x1="0" y1="90" x2="100" y2="90" stroke="black" />}
  <g class="points">
    {points.map((p) => <Dot key={p.id} x={p.x} y={p.y} />)}
  </g>
  <Badge x={60} label="new" />
  <foreignObject width="100" height="20">
    {showAxis && <p class="html">html inside svg</p>}
  </foreignObject>
</svg>
<button class="add-point" onClick={() => points.set([...points, { id: points.length + 1, x: 50, y: 60 }])}>add point</button>
<button class="toggle-axis" onClick={() => showAxis.set(!showAxis)}>axis</button>
