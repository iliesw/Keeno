{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Keeno",
  "scopeName": "source.keeno",
  "fileTypes": ["kn"],
  "patterns": [{ "include": "#comment" }, { "include": "#script" }, { "include": "#style" }, { "include": "#markup" }],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "captures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "tag-attributes": {
      "patterns": [
        {
          "match": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "string.quoted.html" }
          }
        },
        { "match": "[a-zA-Z_:][-a-zA-Z0-9_:.]*", "name": "entity.other.attribute-name.html" }
      ]
    },
    "script": {
      "begin": "(<)(script)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=>)(?!</script)",
          "end": "(?=</script\\s*>)",
          "contentName": "meta.embedded.block.keeno.script source.tsx",
          "patterns": [{ "include": "source.tsx" }]
        }
      ]
    },
    "style": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=>)(?!</style)",
          "end": "(?=</style\\s*>)",
          "contentName": "meta.embedded.block.keeno.style source.css",
          "patterns": [{ "include": "source.css" }]
        }
      ]
    },
    "markup": {
      "patterns": [{ "include": "#comment" }, { "include": "source.tsx#jsx-children" }]
    }
  }
}
