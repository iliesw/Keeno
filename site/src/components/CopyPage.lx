<script lang="ts">
  import Icon from './Icon.lx'
  import { sourcePath } from '../docs'
  import { GITHUB } from '../icons'

  const { raw, slug } = props<{ raw: string; slug: string }>()
  const copied = state(false)
  const open = state(false)

  const CURSOR =
    '<svg viewBox="0 0 466.73 532.09" width="16" height="16" fill="currentColor"><path d="M457.43,125.94L244.42,2.96c-6.84-3.95-15.28-3.95-22.12,0L9.3,125.94c-5.75,3.32-9.3,9.46-9.3,16.11v247.99c0,6.65,3.55,12.79,9.3,16.11l213.01,122.98c6.84,3.95,15.28,3.95,22.12,0l213.01-122.98c5.75-3.32,9.3-9.46,9.3-16.11v-247.99c0-6.65-3.55-12.79-9.3-16.11h-.01ZM444.05,151.99l-205.63,356.16c-1.39,2.4-5.06,1.42-5.06-1.36v-233.21c0-4.66-2.49-8.97-6.53-11.31L24.87,145.67c-2.4-1.39-1.42-5.06,1.36-5.06h411.26c5.84,0,9.49,6.33,6.57,11.39h-.01Z"/></svg>'
  const CLAUDE =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l1.6 6.4L20 7l-4.8 4.6L22 14l-6.8.4L17 21l-5-4.4L7 21l1.8-6.6L2 14l6.8-2.4L4 7l6.4 1.4z"/></svg>'

  async function copy() {
    try {
      await navigator.clipboard.writeText(raw)
      copied.set(true)
      setTimeout(() => copied.set(false), 1000)
    } catch {
      alert('Failed to copy the page')
    }
  }

  function openIn(base: string) {
    const prompt = `Read ${location.href}, I want to ask questions about it.`
    window.open(base + encodeURIComponent(prompt), '_blank')
    open.set(false)
  }

  init(() => {
    const close = (e: MouseEvent) => {
      if (!(e.target as Element).closest('#copy-page')) open.set(false)
    }
    document.addEventListener('click', close)
    return () => document.removeEventListener('click', close)
  })
</script>

<div id="copy-page" class="absolute top-0 right-0 flex h-8 rounded-lg border bg-neutral-100 dark:bg-neutral-900">
  <button type="button" onClick={copy} class="flex cursor-pointer items-center justify-center gap-2 rounded-l-lg px-2.5 text-sm hover:bg-neutral-200 dark:text-neutral-200 dark:hover:bg-neutral-800 dark:hover:text-white">
    <Icon name={copied ? 'check' : 'copy'} />
    {copied ? 'Copied' : 'Copy Page'}
  </button>
  <button type="button" aria-label="More options" aria-expanded={open} onClick={() => open.set(!open)} class="cursor-pointer rounded-r-lg border-l p-2 transition-all hover:bg-neutral-200 dark:text-neutral-200 dark:hover:bg-neutral-800">
    <span class={['inline-flex transition-transform', open && 'rotate-180']}><Icon name="chevronDown" /></span>
  </button>
  {open && (
    <div class="animate-fade-up absolute top-9 right-0 z-30 flex w-48 flex-col rounded-[11px] border bg-neutral-100 p-0.75 text-sm shadow-xl dark:bg-neutral-900">
      <button type="button" onClick={() => openIn('https://cursor.com/link/prompt?text=')} class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1 text-left hover:bg-neutral-200 dark:hover:bg-neutral-800">
        <span class="inline-flex opacity-60" innerHTML={CURSOR}></span> Open in Cursor
      </button>
      <button type="button" onClick={() => openIn('https://claude.ai/new?q=')} class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1 text-left hover:bg-neutral-200 dark:hover:bg-neutral-800">
        <span class="inline-flex opacity-60" innerHTML={CLAUDE}></span> Open in Claude
      </button>
      <a href={`${GITHUB}/blob/main/${sourcePath(slug)}`} target="_blank" rel="noreferrer" class="flex items-center gap-2 rounded-md px-2 py-1 hover:bg-neutral-200 dark:hover:bg-neutral-800">
        <Icon name="markdown" class="opacity-60" /> View as Markdown
      </a>
      <a href={`${GITHUB}/edit/main/${sourcePath(slug)}`} target="_blank" rel="noreferrer" class="flex items-center gap-2 rounded-md px-2 py-1 hover:bg-neutral-200 dark:hover:bg-neutral-800">
        <Icon name="edit" class="opacity-60" /> Edit on GitHub
      </a>
    </div>
  )}
</div>
