<script lang="ts">
  import { Link } from '@inflector/keeno-router'
  import { runtimeKb } from 'virtual:keeno-stats'
  import Footer from '../components/Footer.kn'
  import Icon from '../components/Icon.kn'
  import Navbar from '../components/Navbar.kn'
  import Meta from '../components/Meta.kn'
  import ExampleExplorer from '../components/ExampleExplorer.kn'
  import HeroCanvas from '../components/HeroCanvas.kn'
  import HeroShowcase from '../components/HeroShowcase.kn'
  import StatsStrip from '../components/StatsStrip.kn'
  import type { Stat } from '../components/stats'
  import { onContentClick } from '../content'
  import { examples } from '../examples'
  import { logo, type IconName } from '../icons'
  import compiled from '../snippets/Counter.kn?compiled'
  import source from '../snippets/Counter.kn?highlight'
  import { VERSION } from '../version'

  const INSTALL = 'bun add @inflector/keeno'
  const copied = state(false)
  function copyInstall() {
    navigator.clipboard?.writeText(INSTALL)
    copied.set(true)
    setTimeout(() => copied.set(false), 1200)
  }



  const stats: Stat[] = [
    { value: Number(runtimeKb), decimals: 1, suffix: 'KB', kicker: 'Runtime', label: 'The whole runtime, min + gzip', text: 'Reactivity, components, lists and built-ins. The rest of your bundle is your code.', href: '/docs/api', art: 'size', wide: true },
    { value: 0, kicker: 'Rendering', label: 'Virtual DOM nodes', text: 'A change goes straight to the text node or attribute that shows it.', href: '/docs/reactivity', art: 'direct' },
    { value: 1, suffix: '×', kicker: 'Lifecycle', label: 'Each component runs once', text: 'Setup code never re-runs, so there are no hooks rules or dependency arrays.', href: '/docs/components#lifecycle', art: 'once' },
    { value: examples.length, kicker: 'Examples', label: 'Live examples to play with', text: 'Every one runs on this site. Open any of them in the playground and change it.', href: '/examples', art: 'grid', wide: true },
  ]

  // Logos from svgl.app, in public/logos. `dark` is a variant for the dark theme.
  const tools: { name: string; role: string; logo: string; dark?: string; href: string }[] = [
    { name: 'Vite', role: 'Dev server, HMR and builds', logo: 'vite', href: '/docs/getting-started' },
    { name: 'Bun', role: 'Packages, scripts and tests', logo: 'bun', href: '/docs/getting-started' },
    { name: 'TypeScript', role: 'Typed props in .kn files', logo: 'typescript', href: '/docs/components#props' },
    { name: 'Tailwind CSS', role: 'Utilities and @apply in components', logo: 'tailwindcss', href: '/docs/styles#tailwind-css' },
    { name: 'VS Code', role: 'IntelliSense for .kn files', logo: 'vscode', href: '/docs/tooling' },
    { name: 'Node.js', role: 'Server rendering', logo: 'nodejs', href: '/docs/ssr' },
    { name: 'Deno', role: 'Server rendering', logo: 'deno', dark: 'deno_dark', href: '/docs/ssr' },
    { name: 'Playwright', role: 'Dev tools stay out of e2e runs', logo: 'playwright', href: '/docs/tooling#dev-tools-panel' },
  ]

  const features: { icon: IconName; title: string; text: string; points: string[]; wide?: boolean; href: string }[] = [
    {
      icon: 'zap',
      title: 'Fine-grained signals',
      text: 'state() creates a signal, derived() computes from others. Templates subscribe to exactly what they read, so a change updates one text node, not a component tree.',
      points: ['No virtual DOM', 'Batched DOM updates', 'persist, url, history, debounce options'],
      wide: true,
      href: '/docs/reactivity',
    },
    { icon: 'palette', title: 'Scoped CSS', text: 'Every <style> is scoped to its component, with :global() as the escape hatch and first-class Tailwind CSS v4.', points: [], href: '/docs/styles' },
    { icon: 'cpu', title: 'Compiled', text: 'The compiler turns HTML-first .kn files into direct DOM code. Components run once and never re-render.', points: [], href: '/docs/components' },
    { icon: 'move', title: 'Reparenting', text: 'Move live content between places, iframes and videos included, without re-creating it, using native moveBefore.', points: [], href: '/docs/built-ins#reparentable' },
    { icon: 'server', title: 'SSR & hydration', text: 'renderToString on Node, Bun or Deno, hydrate in the browser. This site is rendered that way.', points: [], href: '/docs/ssr' },
    {
      icon: 'wrench',
      title: 'Tooling',
      text: 'A Vite plugin with HMR, a VS Code extension with full TypeScript IntelliSense in .kn files, and keeno-check for CI.',
      points: ['Vite plugin + HMR', 'VS Code extension', 'keeno-check type checker'],
      wide: true,
      href: '/docs/tooling',
    },
    { icon: 'route', title: 'Router', text: 'A tiny History API router with params, lazy routes, active links and server rendering.', points: [], href: '/docs/routing' },
  ]

</script>

<Meta title="Keeno · The compiled, signal-based UI framework" />
<Navbar narrow />
<div class="relative w-full overflow-x-hidden" onClick={onContentClick}>
  <!-- Hero -->
  <section class="relative isolate">
    <div class="hero-fade pointer-events-none absolute inset-x-0 top-0 -z-10 h-[52rem]"><HeroCanvas /></div>
    <div class="hero-glow pointer-events-none absolute inset-0 -z-10"></div>
    <div class="mx-auto flex max-w-400 flex-col items-center px-6 pt-36 text-center md:pt-44">
      <Link href="/playground" class="animate-fade-up group flex items-center gap-2 rounded-full border bg-white/70 py-1 pr-3 pl-1 text-sm shadow-xs backdrop-blur transition hover:border-neutral-300 dark:bg-neutral-950/70 dark:hover:border-neutral-700">
        <span class="rounded-full bg-neutral-900 px-2 py-0.5 font-mono text-[11px] font-medium text-white dark:bg-white dark:text-black">v{VERSION}</span>
        <span class="text-neutral-600 dark:text-neutral-400">Try Keeno in the playground</span>
        <span class="text-neutral-400 transition-transform group-hover:translate-x-0.5"><Icon name="arrowRight" /></span>
      </Link>
      <h1 class="animate-fade-up mt-8 max-w-4xl text-5xl leading-[1.02] font-semibold tracking-[-0.045em] [animation-delay:60ms] sm:text-7xl lg:text-[5.5rem]">
        Write HTML.<br /><span class="text-gradient">Ship fast UIs.</span>
      </h1>
      <p class="animate-fade-up mt-6 max-w-xl text-lg leading-relaxed text-balance text-neutral-600 [animation-delay:120ms] md:text-xl dark:text-neutral-400">
        Keeno compiles your components into precise DOM updates. No virtual DOM, no diffing: when a value changes, only the nodes that read it update.
      </p>
      <div class="animate-fade-up mt-9 flex flex-wrap justify-center gap-3 [animation-delay:180ms]">
        <Link href="/docs/getting-started" class="flex h-11 items-center gap-2 rounded-full bg-neutral-900 px-6 font-medium text-white transition hover:bg-neutral-700 dark:bg-white dark:text-black dark:hover:bg-neutral-200">
          Get started <Icon name="arrowRight" />
        </Link>
        <Link href="/playground" class="flex h-11 items-center gap-2 rounded-full border bg-white px-6 font-medium transition hover:bg-neutral-50 dark:bg-neutral-950 dark:hover:bg-neutral-900">
          <Icon name="play" /> Playground
        </Link>
      </div>
      <button type="button" onClick={copyInstall} class="animate-fade-up group mt-5 flex cursor-pointer items-center gap-3 rounded-lg px-3 py-1.5 font-mono text-sm text-neutral-500 transition [animation-delay:240ms] hover:bg-neutral-100 hover:text-neutral-900 dark:hover:bg-neutral-900 dark:hover:text-white" title="Copy">
        <span class="text-neutral-400 dark:text-neutral-600">$</span> {INSTALL}
        <span class="opacity-50 group-hover:opacity-100"><Icon name={copied ? 'check' : 'copy'} /></span>
      </button>
    </div>

    <!-- Live editor-like showcase -->
    <div class="animate-fade-up mx-auto mt-20 w-full max-w-6xl px-4 [animation-delay:300ms] md:mt-24 md:px-6">
      <HeroShowcase />
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="section-label">By the numbers</p>
        <h2 class="section-title">Small, direct, predictable.</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-neutral-500">
        The compiler does the work ahead of time, so what runs in the browser is a tiny runtime and code that writes to the page directly.
      </p>
    </div>
    <StatsStrip items={stats} />
  </section>

  <!-- Compiler output -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
      <p class="section-label">Under the hood</p>
      <h2 class="section-title">Compiled to plain DOM code</h2>
      <p class="text-neutral-600 dark:text-neutral-400">
        The compiler reads your markup once and writes the code a careful human would: clone a template, wire one event, and bind each <code class="font-mono text-[0.9em]">{'{expression}'}</code> to exactly the text node it fills.
      </p>
    </div>
    <div class="home-compare mt-10 grid items-stretch gap-4 lg:grid-cols-[minmax(0,5fr)_auto_minmax(0,7fr)]">
      <div class="min-w-0" innerHTML={source.html}></div>
      <div class="hidden items-center justify-center lg:flex">
        <span class="grid size-9 place-items-center rounded-full border bg-white text-neutral-500 dark:bg-neutral-950"><Icon name="arrowRight" /></span>
      </div>
      <div class="min-w-0" innerHTML={compiled.html}></div>
    </div>
    <div class="mt-4 grid gap-px overflow-hidden rounded-2xl border bg-neutral-200 text-sm sm:grid-cols-3 dark:bg-neutral-800">
      <p class="flex gap-2.5 bg-white p-5 dark:bg-ink"><span class="mt-0.5 text-neutral-400"><Icon name="checkSm" /></span> <span class="text-neutral-600 dark:text-neutral-400"><b class="font-medium text-neutral-900 dark:text-white">Reads become <code class="font-mono">.get()</code></b>: the compiler tracks which names are states.</span></p>
      <p class="flex gap-2.5 bg-white p-5 dark:bg-ink"><span class="mt-0.5 text-neutral-400"><Icon name="checkSm" /></span> <span class="text-neutral-600 dark:text-neutral-400"><b class="font-medium text-neutral-900 dark:text-white">One template clone</b> builds the static markup in a single call.</span></p>
      <p class="flex gap-2.5 bg-white p-5 dark:bg-ink"><span class="mt-0.5 text-neutral-400"><Icon name="checkSm" /></span> <span class="text-neutral-600 dark:text-neutral-400"><b class="font-medium text-neutral-900 dark:text-white">Two text nodes</b> update when <code class="font-mono">count</code> changes. Nothing else runs.</span></p>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="section-label">Features</p>
        <h2 class="section-title">Everything you need,<br /><span class="text-neutral-400 dark:text-neutral-600">nothing you don't.</span></h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-neutral-500">
        A script, some markup and a scoped style: that's a component. Built-ins cover the hard parts: error boundaries, async data, portals, transitions and state-preserving reparenting.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border bg-neutral-200 md:grid-cols-3 dark:bg-neutral-800">
      {features.map((f) => (
        <Link key={f.title} href={f.href} class={['group relative flex min-h-60 flex-col gap-4 overflow-hidden bg-white p-7 transition-colors hover:bg-neutral-50 dark:bg-ink dark:hover:bg-neutral-950', f.wide && 'md:col-span-2']}>
          <div class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg border bg-white text-neutral-700 shadow-xs dark:bg-neutral-950 dark:text-neutral-300"><Icon name={f.icon} /></span>
            <h3 class="text-lg font-medium tracking-tight">{f.title}</h3>
            <span class="ml-auto -translate-x-1 text-neutral-400 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100"><Icon name="arrowUpRight" /></span>
          </div>
          <p class={['text-sm leading-relaxed text-neutral-600 dark:text-neutral-400', f.wide && 'md:w-3/5']}>{f.text}</p>
          {f.points.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-2">
              {f.points.map((p) => (
                <span key={p} class="rounded-full border px-2.5 py-0.5 font-mono text-xs text-neutral-600 dark:text-neutral-400">{p}</span>
              ))}
            </div>
          )}
          <span class={['pointer-events-none absolute -right-10 -bottom-10 text-neutral-900 opacity-[0.03] transition duration-700 group-hover:scale-110 group-hover:-rotate-6 group-hover:opacity-[0.06] dark:text-white', !f.wide && 'hidden']} innerHTML={logo('size-56')}></span>
        </Link>
      ))}
    </div>
  </section>

  <!-- Examples -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="section-label">Examples</p>
        <h2 class="section-title">See it, then change it.</h2>
      </div>
      <Link href="/examples" class="flex w-fit items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition hover:bg-neutral-50 dark:hover:bg-neutral-900">
        All {examples.length} examples <Icon name="arrowRight" />
      </Link>
    </div>
    <ExampleExplorer />
  </section>

  <!-- Tools -->
  <section class="mx-auto mt-32 max-w-6xl px-4 md:px-6">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="section-label">Tooling</p>
        <h2 class="section-title">Works with your tools.</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-neutral-500">
        Vite for dev and builds, Bun for packages and tests, Node, Bun or Deno to render on the server. Bring TypeScript and Tailwind: they just work.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border bg-neutral-200 md:grid-cols-4 dark:bg-neutral-800">
      {tools.map((t) => (
        <Link key={t.name} href={t.href} class="tool-card group relative flex flex-col gap-6 bg-white p-6 transition-colors hover:bg-neutral-50 dark:bg-ink dark:hover:bg-neutral-950">
          <div class="flex items-start justify-between">
            <span class="tool-logo grid size-12 place-items-center rounded-xl border bg-white shadow-xs dark:bg-neutral-950">
              <img src={`/logos/${t.logo}.svg`} alt="" width="26" height="26" class={['size-6.5', t.dark && 'dark:hidden']} />
              {t.dark && <img src={`/logos/${t.dark}.svg`} alt="" width="26" height="26" class="hidden size-6.5 dark:block" />}
            </span>
            <span class="-translate-x-1 text-neutral-400 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100"><Icon name="arrowUpRight" /></span>
          </div>
          <div>
            <p class="font-medium tracking-tight">{t.name}</p>
            <p class="mt-0.5 text-sm text-neutral-500">{t.role}</p>
          </div>
        </Link>
      ))}
    </div>
  </section>
</div>
<Footer narrow />
