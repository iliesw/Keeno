<script lang="ts">
  type Props = {
    todo: { id: number; text: string; done: boolean }
    onToggle: (id: number) => void
    onRemove: (id: number) => void
  }
  const { todo, onToggle, onRemove } = props<Props>()

  init(() => console.log(`[TodoItem] init ${todo.text}`))
  destroy(() => console.log(`[TodoItem] destroy ${todo.text}`))
</script>

<li class={todo.done ? 'done' : ''}>
  <label>
    <input type="checkbox" checked={todo.done} onChange={() => onToggle(todo.id)} />
    <span>{todo.text}</span>
  </label>
  <button type="button" aria-label={`Remove ${todo.text}`} onClick={() => onRemove(todo.id)}>✕</button>
</li>

<style>
  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0;
    border-bottom: 1px solid #eee;
  }
  .done span {
    text-decoration: line-through;
    color: #999;
  }
  button {
    background: crimson;
    color: white;
    border: 0;
    border-radius: 50%;
    width: 1.6rem;
    height: 1.6rem;
    cursor: pointer;
  }
</style>
