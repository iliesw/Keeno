<script lang="ts">
  import { Link } from '@inflector/keeno-router'
  import { GITHUB } from '../icons'

  // `narrow` matches pages whose content is 72rem wide (the home page).
  const { narrow = false } = props<{ narrow?: boolean }>()
  const container = derived(() => (narrow ? 'max-w-6xl px-4 md:px-6' : 'max-w-400 px-6 md:px-10'))

  const columns = [
    {
      title: 'Learn',
      links: [
        { label: 'Introduction', href: '/docs/introduction' },
        { label: 'Quick start', href: '/docs/getting-started' },
        { label: 'Reactivity', href: '/docs/reactivity' },
        { label: 'Templates', href: '/docs/templates' },
      ],
    },
    {
      title: 'Build',
      links: [
        { label: 'Examples', href: '/examples' },
        { label: 'Playground', href: '/playground' },
        { label: 'Routing', href: '/docs/routing' },
        { label: 'Server rendering', href: '/docs/ssr' },
      ],
    },
    {
      title: 'Reference',
      links: [
        { label: 'Cheatsheet', href: '/docs/cheatsheet' },
        { label: 'API reference', href: '/docs/api' },
        { label: 'Tooling', href: '/docs/tooling' },
        { label: 'llms.txt', href: `${GITHUB}/blob/main/llms.txt` },
      ],
    },
    {
      title: 'Community',
      links: [
        { label: 'GitHub', href: GITHUB },
        { label: 'Issues', href: `${GITHUB}/issues` },
        { label: 'Contributing', href: `${GITHUB}/blob/main/CONTRIBUTING.md` },
      ],
    },
  ]

  const legal = [
    { label: 'MIT License', href: `${GITHUB}/blob/main/LICENSE` },
    { label: 'Security', href: '/docs/security' },
    { label: 'Versioning', href: '/docs/stability' },
  ]
  const external = (href: string) => href.startsWith('http')
</script>

<footer class="mt-32 overflow-hidden border-t">
  <div class={['mx-auto grid w-full grid-cols-2 gap-x-6 gap-y-12 pt-16 pb-10 md:grid-cols-5', container]}>
    {columns.map((c) => (
      <div key={c.title} class="flex flex-col gap-4">
        <p class="font-mono text-[11px] tracking-widest text-neutral-500 uppercase">{c.title}</p>
        <div class="flex flex-col gap-1.5 border-l pl-3.5">
          {c.links.map((l) => (
            <span key={l.label} class="contents">
              {external(l.href) ? (
                <a href={l.href} target="_blank" rel="noreferrer" class="foot-link">{l.label}</a>
              ) : (
                <Link href={l.href} class="foot-link">{l.label}</Link>
              )}
            </span>
          ))}
        </div>
      </div>
    ))}

    <!-- The last column runs the full height, beside the wordmark -->
    <div class="col-span-2 flex flex-col gap-4 md:col-span-1 md:row-span-2">
      <p class="font-mono text-[11px] tracking-widest text-neutral-500 uppercase">Start</p>
      <div class="flex flex-1 flex-col items-start gap-3 border-l pl-3.5">
        <Link href="/docs/getting-started" class="flex h-9 items-center rounded-full bg-neutral-900 px-4 font-mono text-[11px] tracking-wider text-white uppercase transition hover:bg-neutral-700 dark:bg-white dark:text-black dark:hover:bg-neutral-200">Get started</Link>
        <Link href="/playground" class="flex h-9 items-center rounded-full border border-neutral-300 px-4 font-mono text-[11px] tracking-wider uppercase transition hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-900">Open the playground</Link>
        <div class="mt-6 flex flex-col gap-2.5">
          {legal.map((l) => (
            <span key={l.label} class="contents">
              {external(l.href) ? (
                <a href={l.href} target="_blank" rel="noreferrer" class="foot-small">{l.label}</a>
              ) : (
                <Link href={l.href} class="foot-small">{l.label}</Link>
              )}
            </span>
          ))}
        </div>
        <div class="mt-auto flex flex-col gap-1.5 pt-8">
          <a href="https://inflector.io" target="_blank" rel="noreferrer" class="group flex w-fit items-baseline gap-1.5 text-neutral-500 transition hover:text-neutral-900 dark:hover:text-white">
            <span class="font-mono text-[11px] tracking-wider uppercase">Made by</span>
            <span class="font-[Inflector] text-base tracking-wide text-neutral-900 dark:text-white">INFLECTOR</span>
          </a>
          <p class="font-mono text-[11px] tracking-wider text-neutral-500 uppercase">© {new Date().getFullYear()} Keeno</p>
        </div>
      </div>
    </div>

    <Link href="/" aria-label="Keeno home" class="foot-mark col-span-2 flex items-end self-end leading-none md:col-span-4">
      <span>Keeno</span>
    </Link>
  </div>
</footer>

