<script lang="ts">
  import { inject } from '@inflector/keeno'
  import { ACCENTS, AccentContext, color, type Accent } from './theme'

  // An injected state reads like a local one, and .set() writes to the provider's state.
  const accent = inject(AccentContext)
  const names = Object.keys(ACCENTS) as Accent[]
</script>

<div class="picker" role="radiogroup" aria-label="Accent colour">
  {names.map((name) => (
    <button
      key={name}
      role="radio"
      aria-checked={accent === name}
      class={{ on: accent === name }}
      style={`--c:${color(name)}`}
      onClick={() => accent.set(name)}
    >
      <span class="dot"></span>{name}
    </button>
  ))}
</div>

<style>
  .picker {
    display: flex;
    gap: 2px;
    width: fit-content;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background: var(--surface);
  }
  button {
    min-height: 1.75rem;
    padding: 0 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: none;
    box-shadow: none;
    color: var(--muted);
    text-transform: capitalize;
  }
  button:hover:not(:disabled) {
    border-color: transparent;
    background: none;
    color: var(--fg);
  }
  button.on,
  button.on:hover:not(:disabled) {
    border-color: var(--border);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .on .dot {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 25%, transparent);
  }
</style>
