<script lang="ts">
  import Aside from '../components/Aside.kn'
  import CopyPage from '../components/CopyPage.kn'
  import Icon from '../components/Icon.kn'
  import Navbar from '../components/Navbar.kn'
  import Pager from '../components/Pager.kn'
  import Sidebar from '../components/Sidebar.kn'
  import NotFound from './NotFound.kn'
  import { onContentClick } from '../content'
  import { findPage, getDoc, loadDoc, nav, pages, sourcePath, type DocModule } from '../docs'
  import { GITHUB } from '../icons'

  const { params } = props<{ params: { slug?: string } }>()

  const slug = derived(() => params.slug ?? pages[0].slug)
  const page = derived(() => findPage(slug))
  const group = derived(() => nav.find((g) => g.items.some((i) => i.slug === slug))?.title ?? '')
  // Filled from the cache on the server and while hydrating; loaded on client-side navigation.
  const doc = state<DocModule | undefined>(getDoc(slug))
  const html = derived(() => (doc ? doc.html : ''))
  const headings = derived(() => (doc ? doc.headings : []))
  const raw = derived(() => (doc ? doc.raw : ''))
  const updated = derived(() => {
    if (!doc || !doc.updated) return ''
    const d = new Date(`${doc.updated}T12:00:00Z`)
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  })
  const minutes = derived(() => Math.max(1, Math.round((raw.split(/\s+/).length || 0) / 220)))

  function sync() {
    const s = slug.peek()
    const p = page.peek()
    if (p) document.title = `${p.title} · Keeno`
    const cached = getDoc(s)
    if (cached) {
      doc.set(cached)
      return
    }
    loadDoc(s).then((d) => {
      if (slug.peek() === s) doc.set(d)
    })
  }
  init(sync)
  update(sync, [slug, page])
</script>

{page ? (
  <div>
    <Navbar />
    <div class="mx-auto flex min-h-screen max-w-400 justify-between gap-2 px-0 pt-24 md:gap-12 md:px-8">
      <aside class="sticky top-24 hidden max-h-[calc(100svh-7rem)] self-start overflow-x-hidden overflow-y-auto pr-2 pl-2 [scrollbar-width:none] hover:[scrollbar-width:thin] min-[1080px]:block">
        <Sidebar />
      </aside>
      <main class="relative mx-6 w-full min-w-0 max-w-3xl md:mr-16 xl:mr-0">
        <p class="mb-4 flex items-center gap-2 text-sm text-neutral-500">
          {group}
          <span class="text-neutral-300 dark:text-neutral-700">/</span>
          <span>{minutes} min read</span>
        </p>
        <article class="doxy" onClick={onContentClick}>
          <div class="contents" innerHTML={html}></div>
        </article>
        <div class="mt-12 flex flex-wrap items-center justify-between gap-3 text-sm text-neutral-500">
          <a href={`${GITHUB}/edit/main/${sourcePath(slug)}`} target="_blank" rel="noreferrer" class="flex items-center gap-1.5 transition hover:text-neutral-900 dark:hover:text-white">
            <Icon name="edit" /> Edit this page on GitHub
          </a>
          {updated && <span>Last updated {updated}</span>}
        </div>
        <Pager slug={slug} />
        <div class="h-32"></div>
        <CopyPage raw={raw} slug={slug} />
      </main>
      <aside class="sticky top-24 hidden self-start xl:block">
        <Aside headings={headings} />
      </aside>
    </div>
  </div>
) : (
  <NotFound />
)}
