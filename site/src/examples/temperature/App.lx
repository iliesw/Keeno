<script lang="ts">
  // One source of truth, in °C. validate() rounds every write and rejects non-numbers.
  const celsius = state(21, {
    validate: (next, prev) => (Number.isFinite(next) ? Math.round(next * 10) / 10 : prev),
  })
  const fahrenheit = derived(() => Math.round((celsius * 9) / 5 + 32))
  const feel = derived(() =>
    celsius < 0 ? '🥶 Freezing' : celsius < 15 ? '🧥 Chilly' : celsius < 25 ? '😌 Pleasant' : celsius < 35 ? '☀️ Warm' : '🔥 Hot',
  )
  const hue = derived(() => Math.max(0, Math.min(240, 200 - celsius * 5)))

  const fromF = (e: Event) => celsius.set(((Number((e.target as HTMLInputElement).value) - 32) * 5) / 9)
</script>

<div class="card" style={`--hue: ${hue}`}>
  <div class="fields">
    <label>
      Celsius
      <input type="number" step="0.5" value={celsius} onInput={(e) => celsius.set(Number((e.target as HTMLInputElement).value))} />
    </label>
    <span class="eq">=</span>
    <label>
      Fahrenheit
      <input type="number" value={fahrenheit} onChange={fromF} />
    </label>
  </div>
  <input type="range" min="-20" max="45" step="0.5" value={celsius} onInput={(e) => celsius.set(Number((e.target as HTMLInputElement).value))} />
  <p class="feel">{feel}</p>
</div>

<style>
  .card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 16px;
    background: linear-gradient(135deg, hsl(var(--hue) 90% 60% / 0.18), transparent);
    border: 1px solid hsl(var(--hue) 80% 55% / 0.4);
    transition: background 0.3s;
  }
  .fields {
    display: flex;
    align-items: end;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.25rem;
    flex: 1;
    font-size: 0.8rem;
    color: var(--muted);
  }
  label input {
    width: 100%;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .eq {
    padding-bottom: 0.5rem;
    color: var(--muted);
  }
  .feel {
    margin: 0;
    text-align: center;
    font-size: 1.25rem;
    font-weight: 600;
  }
</style>
