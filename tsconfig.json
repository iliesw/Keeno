{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    // Workspace packages resolve to their sources, so tests, typechecking and the language server
    // never need a build. Bun applies these at runtime too. Published consumers get dist/ through
    // each package's `exports`; packages/*/tsconfig.build.json turns this off for declaration builds.
    "paths": {
      "lux": ["./packages/lux/src/index.ts"],
      "lux/internal": ["./packages/lux/src/internal.ts"],
      "lux/lx": ["./packages/lux/src/lx.d.ts"],
      "@lux/compiler": ["./packages/compiler/src/index.ts"],
      "@lux/compiler/split": ["./packages/compiler/src/split.ts"],
      "vite-plugin-lux": ["./packages/vite-plugin-lux/src/index.ts"],
      "@lux/language-server": ["./packages/language-server/src/index.ts"],
      "@lux/language-server/server": ["./packages/language-server/src/server.ts"],
      "lux-check": ["./packages/lux-check/src/check.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}
