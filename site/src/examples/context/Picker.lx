<script lang="ts">
  import { inject } from '@inflector/lux'
  import { ACCENTS, AccentContext, color, type Accent } from './theme'

  // An injected state reads like a local one, and .set() writes to the provider's state.
  const accent = inject(AccentContext)
  const names = Object.keys(ACCENTS) as Accent[]
</script>

<div class="picker" role="radiogroup" aria-label="Accent colour">
  {names.map((name) => (
    <button
      key={name}
      role="radio"
      aria-checked={accent === name}
      class={{ on: accent === name }}
      style={`--c:${color(name)}`}
      onClick={() => accent.set(name)}
    >
      <span class="dot"></span>{name}
    </button>
  ))}
</div>

<style>
  .picker {
    display: flex;
    gap: 0.4rem;
  }
  button {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-transform: capitalize;
  }
  button.on {
    border-color: var(--c);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }
</style>
