<script lang="ts">
  import Card from './Card.kn'
  const n = state(1)
  const show = state(true)
</script>

<Card title={`n=${n}`}>
  <b class="n">{n}</b>
  <button class="inc" onClick={() => n.set(n + 1)}>inc</button>
</Card>
{show ? <i class="yes">yes</i> : <i class="no">no</i>}
<button class="toggle" onClick={() => show.set(!show)}>toggle</button>
