<script lang="ts">
  import { Link } from '@inflector/keeno-router'
  import Icon from './Icon.kn'
  import type { Heading } from '../docs'

  const { headings } = props<{ headings: Heading[] }>()

  const active = state('')
  /** The track: one path through every link, bending where the depth changes. */
  const track = state({ d: '', height: 0 })
  /** The part of the track the highlight shows: the active link's vertical range. */
  const thumb = state({ top: 0, bottom: 0, visible: false })
  let list: HTMLElement | null = null

  const lineOffset = (depth: number) => (depth >= 3 ? 12 : 0)
  const itemOffset = (depth: number) => (depth >= 3 ? 28 : 16)
  /** Half the height of a bend between two depths (it is centered on the boundary between links). */
  const BEND = 6

  // Follow the reading position: the active heading is the last one above the top of the page.
  const onScroll = () => {
    let id = headings[0]?.id ?? ''
    for (const h of headings) {
      const el = document.getElementById(h.id)
      if (el && el.getBoundingClientRect().top <= 130) id = h.id
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4
    if (atBottom && headings.length) id = headings[headings.length - 1].id
    active.set(id)
  }
  init(() => {
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  })
  const measure = () => {
    const frame = requestAnimationFrame(onScroll)
    return () => cancelAnimationFrame(frame)
  }
  init(measure)
  update(measure, [headings])

  // Build the track from where the links actually are: a vertical line per depth, and a diagonal
  // where it changes. +0.5 keeps the 1px line on the pixel grid.
  const layout = () => {
    if (!list) return
    const links = [...list.querySelectorAll<HTMLElement>('a[data-id]')]
    let d = ''
    links.forEach((link, i) => {
      const x = lineOffset(headings[i]?.depth ?? 2) + 0.5
      const top = link.offsetTop
      const bottom = top + link.offsetHeight
      const next = headings[i + 1]
      const bends = next && lineOffset(next.depth) !== lineOffset(headings[i].depth)
      if (i === 0) d += `M${x} ${top}`
      d += ` L${x} ${bends ? bottom - BEND : bottom}`
      if (bends) d += ` L${lineOffset(next.depth) + 0.5} ${bottom + BEND}`
    })
    track.set({ d, height: list.offsetHeight })
    placeThumb()
  }
  init(() => {
    layout()
    // Fonts loading and window resizes move the links.
    const ro = new ResizeObserver(layout)
    if (list) ro.observe(list)
    return () => ro.disconnect()
  })
  update(() => {
    const frame = requestAnimationFrame(layout)
    return () => cancelAnimationFrame(frame)
  }, [headings])

  // Slide the highlight to the active link's range of the track.
  const placeThumb = () => {
    const id = active.peek()
    const link = id ? list?.querySelector<HTMLElement>(`a[data-id="${CSS.escape(id)}"]`) : null
    if (!link) return thumb.set({ ...thumb.peek(), visible: false })
    thumb.set({ top: link.offsetTop, bottom: link.offsetTop + link.offsetHeight, visible: true })
  }
  update(placeThumb, [active])
</script>

<!-- Always rendered (pages without sections keep "Back to top" and the playground link); the list div
     stays in the DOM so the track can be measured as soon as a page with sections loads. -->
<nav id="toc" class="flex w-64 min-w-64 flex-col gap-3 pr-4 pb-2" aria-label="On this page">
    {headings.length > 0 && <p class="flex h-6 items-center gap-2 text-sm font-semibold"><Icon name="listMinus" /> On this page</p>}
    <div class="relative flex flex-col" ref={(el) => (list = el)}>
      <svg class={['pointer-events-none absolute top-0 left-0 overflow-visible', !headings.length && 'hidden']} width="16" height={track.height} aria-hidden="true">
        <path d={track.d} fill="none" class="stroke-neutral-200 dark:stroke-neutral-800" stroke-width="1" />
        <path
          d={track.d}
          fill="none"
          class="toc-thumb stroke-brand dark:stroke-white"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style={`clip-path:inset(${thumb.top}px -4px ${Math.max(0, track.height - thumb.bottom)}px -4px);opacity:${thumb.visible ? 1 : 0}`}
        />
      </svg>
      {headings.map((h) => (
        <a
          key={h.id}
          href={`#${h.id}`}
          data-id={h.id}
          style={`padding-left:${itemOffset(h.depth)}px`}
          class={[
            'relative block py-1.5 text-sm transition-colors',
            active === h.id
              ? 'font-medium text-neutral-900 dark:text-white'
              : 'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100',
          ]}
        >
          <span class="block truncate">{h.text}</span>
        </a>
      ))}
    </div>
    <div class={['flex flex-col gap-2 text-sm text-neutral-500', headings.length > 0 && 'mt-3 border-t pt-4']}>
      <button type="button" onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })} class="flex w-fit cursor-pointer items-center gap-2 transition hover:text-neutral-900 dark:hover:text-white">
        <span class="rotate-90"><Icon name="arrowLeft" /></span> Back to top
      </button>
      <Link href="/playground" class="flex w-fit items-center gap-2 transition hover:text-neutral-900 dark:hover:text-white">
        <Icon name="play" /> Try it in the playground
      </Link>
    </div>
  </nav>

<style>
  /* The highlight slides along the track (and around its bends) as the active link changes. */
  .toc-thumb {
    transition:
      clip-path 0.2s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.15s;
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-thumb {
      transition: none;
    }
  }
</style>
